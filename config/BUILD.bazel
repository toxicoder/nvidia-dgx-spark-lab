"""Package purpose: Lab resource policy YAML/JSON, Grafana dashboard filegroups, and the dashboard generator entry point for tests and scripts."""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "resource_policy",
    srcs = [
        "lab-domains.json",
        "lab-domains.yaml",
        "monitoring-probes.yaml",
        "nemotron-catalog.yaml",
        "open-webui-policy.json",
        "open-webui-policy.yaml",
        "resource-policy.json",
        "resource-policy.yaml",
        "sso-policy.yaml",
    ],
)

filegroup(
    name = "disk_catalog",
    srcs = ["disk-catalog.yaml"],
)

filegroup(
    name = "lab_identities",
    srcs = ["lab-identities.yaml"],
)

# The one checked-in feature-flag registry. //tests:flags_registry gates it: every
# flag declares a default, owner, expiry and one reader, and only a declared
# capability may default on.
filegroup(
    name = "flags_registry",
    srcs = ["flags.yaml"],
)

filegroup(
    name = "grafana_dashboards",
    srcs = glob(["grafana/dashboards/*.json"]),
    visibility = [
        "//config:__pkg__",
        "//tests:__pkg__",
    ],
)

# Grafana dashboard JSON is generated from this single Python source.
filegroup(
    name = "generate_dashboards_sources",
    srcs = ["grafana/generate-dashboards.py"],
)

# Regenerate the dashboards: bazelisk run //config:generate-dashboards
sh_binary(
    name = "generate-dashboards",
    srcs = ["run_generate_dashboards.sh"],
    data = [":generate_dashboards_sources"],
    visibility = ["//visibility:public"],
)

# Aggregate every artifact in this package; //:everything depends on it.
filegroup(
    name = "all",
    srcs = [
        ":disk_catalog",
        ":flags_registry",
        ":generate_dashboards_sources",
        ":grafana_dashboards",
        ":lab_identities",
        ":resource_policy",
    ],
    visibility = ["//visibility:public"],
)
