"""Package purpose: Documentation content package — markdown/MDX pages, generators, and the Bazel entry points that drive the Fumadocs site in docs-site/.

The site itself is the Next.js app in `docs-site/` (see that package for the npm runners).
This package owns the *content*: the pages under `docs/`, the generators that fill
`docs/generated/`, and the Python gates around them.

Content deliberately stays here rather than moving into `docs-site/` so that:

- the generators keep writing into `docs/generated/` unchanged,
- Bazel data dependencies keep listing the same files reviewers diff, and
- links from the README, the published GitHub Pages aliases, and the dashboard point at the
  same paths they always did.

Usage:
  bazelisk run //docs:serve            # dev server with hot reload
  bazelisk run //docs:docs             # static export into docs-site/out/
  bazelisk run //docs:preview          # build + serve the export (final check)
  bazelisk run //docs:status           # toolchain / content status
  bazelisk run //docs:render-check         # checks against the export (run //docs:docs first)
  bazelisk run //docs-site:visual-update   # refresh Playwright goldens (review the diff!)

See docs/BUILDING_WITH_BAZEL.md for the target map and MIGRATION.md (repo root) for the port from
Material for MkDocs.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Keep in sync with docs-site/lib/nav.json (enforced by //tests:doc_coverage).
# Subdir pages must be listed by path so runfiles and the coverage gate both see them.
# Names are the on-disk spellings: pages that needed JSX are .mdx, the rest are .md.
_HAND_WRITTEN_MD = [
    "BUILDING_WITH_BAZEL.md",
    "CONTRIBUTING.md",
    "architecture.mdx",
    "concepts/index.md",
    "concepts/interconnect-nccl.mdx",
    "contribute/index.md",
    "dev-environment.mdx",
    "dev-workspaces.mdx",
    "dgx-spark-notes.mdx",
    "getting-started.mdx",
    "gitea-ci-setup.md",
    "glossary.md",
    "hermes-agent.mdx",
    "index.mdx",
    "learn/index.md",
    "litellm-rounded-stack.md",
    "mcp-agent-toolkit.mdx",
    "models-catalog.md",
    "monitoring-observability.mdx",
    "nemotron-agentic-stack.md",
    "open-webui.mdx",
    "operate/ansible-catalog.mdx",
    "operate/backup-restore.mdx",
    "operate/capacity-planning.mdx",
    "operate/disk-wizard.mdx",
    "operate/dashboard.mdx",
    "operate/index.mdx",
    "operate/node-failure.mdx",
    "operate/overlays.mdx",
    "operate/patch-and-reboot.mdx",
    "operate/secrets.mdx",
    "operate/workload-catalog.mdx",
    "project-conventions.md",
    "qwen36-dual-stack.md",
    "reboot-safety.mdx",
    "resource-guard.mdx",
    "sso.mdx",
    "start/choose-topology.mdx",
    "start/index.mdx",
    "start/lab-topology.mdx",
    "start/profiles.mdx",
    "troubleshooting.mdx",
    "visual-generative-ai.mdx",
]

# Generated reference trees: emitted by the generators, never hand-edited.
_RENDER_GENERATED = glob(
    [
        "generated/shell/**",
        "generated/dashboard-api/**",
    ],
    allow_empty = True,
)

# Everything the Next.js app reads out of this directory at build time.
filegroup(
    name = "content",
    srcs = _HAND_WRITTEN_MD + [
        "nvidia-dgx-spark-lab-banner.jpeg",
    ] + glob(
        ["includes/**"],
        allow_empty = True,
    ) + _RENDER_GENERATED,
    visibility = ["//visibility:public"],
)

_DOCS_COMMON_DATA = [
    "generate_shell_docs.py",
    "requirements.txt",
    "setup-docs.sh",
    ":content",
    # Script sources that feed the code generators (so Bazel correctly
    # invalidates docs targets when structured comments or sources change).
    "//scripts:doc_sources",
]

# The site is a Next.js app; these binaries delegate to docs/manage-docs.sh, which in turn
# runs npm inside docs-site/.  The npm runners live in //docs-site for the fast paths.
sh_binary(
    name = "serve",
    srcs = ["manage-docs.sh"],
    args = ["serve"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "docs",
    srcs = ["manage-docs.sh"],
    args = ["build"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "preview",
    srcs = ["manage-docs.sh"],
    args = ["preview"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "status",
    srcs = ["manage-docs.sh"],
    args = ["status"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "clean",
    srcs = ["manage-docs.sh"],
    args = ["clean"],
    visibility = ["//visibility:public"],
)

# Export-backed render checks.  A run target (not an sh_test) because it inspects the real
# docs-site/out/ that //docs:docs produced in the checkout: a sandboxed test action has no
# export to read, which is why //docs:test_docs_site_render covers sources only.
# Usage: bazelisk run //docs:docs && bazelisk run //docs:render-check
sh_binary(
    name = "render-check",
    srcs = ["test_docs_site_render.sh"],
    data = [
        "test_docs_site_render.py",
        "test_docs_site_render.sh",
        ":content",
    ],
    visibility = ["//visibility:public"],
)

# Test for docs production code (generator that emits {{PLACEHOLDER}} content
# consumed by the interactive cluster-variables panel).
sh_test(
    name = "test_generate_shell_docs",
    srcs = ["test_generate_shell_docs.sh"],
    data = [
        "generate_shell_docs.py",
        "test_generate_shell_docs.py",
        "//scripts:doc_sources",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "test_python_coverage",
    srcs = ["test_python_coverage.sh"],
    data = [
        "generate_shell_docs.py",
        "test_generate_shell_docs.py",
        "test_python_coverage.sh",
        # The docs-site python tooling (nav transcriber + codemod) is covered here too.
        "//docs-site:sources",
    ],
    visibility = ["//visibility:public"],
)

# Interactive cluster-vars panel (seed/merge/profile contract + export token fidelity).
sh_test(
    name = "test_command_vars",
    srcs = ["test_command_vars.sh"],
    data = [
        "test_command_vars.py",
        "test_command_vars.sh",
        ":content",
        "//docs-site:sources",
    ],
    visibility = ["//visibility:public"],
)

# Render checks: source-level contract of every navigable page (frontmatter, fences,
# mermaid labels, prose lists) plus the exported HTML when a build is present.
sh_test(
    name = "test_docs_site_render",
    size = "medium",
    timeout = "moderate",
    srcs = ["test_docs_site_render.sh"],
    data = [
        "test_docs_site_render.py",
        "test_docs_site_render.sh",
        ":content",
        "//:CONTRIBUTING.md",
        "//:README.md",
        "//docs-site:sources",
    ],
    visibility = ["//visibility:public"],
)
