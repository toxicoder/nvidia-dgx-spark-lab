"""Package purpose: Aggregate filegroup over every Kubernetes manifest package.

`//k8s:all` is what `//:everything` builds for the cluster configuration, and
what `//tests:bazel_file_coverage` holds accountable for owning every tracked
file under `k8s/`. Every entry is named explicitly: adding a manifest package
means adding its aggregate here.
"""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = [
        "//k8s/auth:manifests",
        "//k8s/auth/generated:generated_auth",
        "//k8s/base:gpu_time_slicing",
        "//k8s/base:kustomization",
        "//k8s/base:namespace",
        "//k8s/base:resource_guard",
        "//k8s/cert-manager:manifests",
        "//k8s/cert-manager/generated:generated_certs",
        "//k8s/dev:dev_dashboard",
        "//k8s/dev:hermes_seed",
        "//k8s/dev:images",
        "//k8s/dev:safety_data",
        "//k8s/dev/dashboard:dashboard_all",
        "//k8s/monitoring:manifests",
        "//k8s/overlays/litellm-dsv41-flash:litellm_dsv41_flash",
        "//k8s/overlays/litellm-glm53-flash:litellm_glm53_flash",
        "//k8s/overlays/litellm-qwen38-27b:litellm_qwen38_27b",
        "//k8s/overlays/litellm-qwen38-flash-next:litellm_qwen38_flash_next",
        "//k8s/overlays/prod:overlay_prod",
        "//k8s/overlays/rounded-stack:rounded_stack",
        "//k8s/overlays/rounded-stack-quality:rounded_stack_quality",
        "//k8s/overlays/single-node:overlay_single",
        "//k8s/overlays/single-node/qwen36-dual:qwen36_dual",
        "//k8s/overlays/test:overlay_test",
        "//k8s/overlays/test/qwen36-dual:qwen36_dual_test",
