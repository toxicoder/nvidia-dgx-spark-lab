        "//k8s/workloads/comfy-visual/flux/fast:flux_fast",
        "//k8s/workloads/comfy-visual/flux/quality:flux_quality",
        "//k8s/workloads/comfy-visual/ltx/balanced:ltx_balanced",
        "//k8s/workloads/comfy-visual/ltx/quality:ltx_quality",
        "//k8s/workloads/deepseek-v4.1-flash:dsv41_flash_job",
