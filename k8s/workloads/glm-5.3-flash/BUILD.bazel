"""Package purpose: GLM-5.3-Flash NVFP4 TP=3 ring inference jobs, Dockerfile, and service exports."""

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "glm53_flash_job",
    srcs = [
        "Dockerfile",
        "glm-5.3-flash-job.yaml",
        "glm-5.3-flash-worker-1-job.yaml",
        "glm-5.3-flash-worker-2-job.yaml",
        "kustomization.yaml",
        "service.yaml",
    ],
    visibility = [
        "//k8s:__subpackages__",
        "//lints:__pkg__",
        "//scripts:__pkg__",
        "//tests:__pkg__",
    ],
)

exports_files([
    "Dockerfile",
    "glm-5.3-flash-job.yaml",
    "glm-5.3-flash-worker-1-job.yaml",
    "glm-5.3-flash-worker-2-job.yaml",
    "kustomization.yaml",
    "service.yaml",
])
