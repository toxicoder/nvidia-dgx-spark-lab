"""Package purpose: LiteLLM management proxy Deployment, Service, and ConfigMap source files."""

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "litellm",
    srcs = glob(["**/*"]),
    visibility = [
        "//k8s:__subpackages__",
        "//lints:__pkg__",
        "//scripts:__pkg__",
        "//tests:__pkg__",
    ],
)

exports_files([
    "kustomization.yaml",
    "litellm-deployment.yaml",
    "service.yaml",
])
