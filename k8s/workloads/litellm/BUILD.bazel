"""Package purpose: LiteLLM management proxy Deployment, Service, and ConfigMap source files."""

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "litellm",
    srcs = [
        "README.md",
        "files/lab-med-frontier-fallback.txt",
        "files/lab-med-system.txt",
        "files/litellm_config.yaml",
        "files/profiles/deepseek-v4.1-flash.yaml",
        "files/profiles/deepseek-v4-flash-dspark.yaml",
        "files/profiles/glm-5.3-flash.yaml",
        "files/profiles/glm-5.3-flash-exl3-tensorfold.yaml",
        "files/profiles/qwen3.8-27b.yaml",
        "files/profiles/qwen3.8-27b-exl3-16gb.yaml",
        "files/profiles/qwen3.8-27b-tensorfold.yaml",
        "files/profiles/qwen3.8-flash-next.yaml",
        "files/profiles/qwen3.8-flash-next-tensorfold.yaml",
        "kustomization.yaml",
        "litellm-deployment.yaml",
        "secrets.example.yaml",
        "service.yaml",
    ],
    visibility = [
        "//k8s:__subpackages__",
        "//lints:__pkg__",
        "//scripts:__pkg__",
        "//tests:__pkg__",
    ],
)

exports_files([
    "kustomization.yaml",
    "litellm-deployment.yaml",
    "service.yaml",
])
