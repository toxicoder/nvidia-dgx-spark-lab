"""Package purpose: Dev dashboard, secret examples, container images, and Hermes seed filegroups."""

"""k8s/dev: developer tools, workspaces dashboard, monitoring helpers.

Contains the custom lab portal + references (Headlamp/Grafana deployed via helm).
"""

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "dev_dashboard",
    srcs = ["//k8s/dev/dashboard:dashboard_all"],
    visibility = [
        "//k8s:__subpackages__",
        "//lints:__pkg__",
        "//scripts:__pkg__",
        "//tests:__pkg__",
    ],
)

filegroup(
    name = "safety_data",
    srcs = [
        "images/coder-workspace/Dockerfile",
        "images/coder-workspace/Dockerfile.dockerignore",
        "images/kasm-spark-desktop/Dockerfile",
        "open-webui/hermes-gateway.yaml",
        "templates/coder-spark-lab/main.tf",
    ],
    visibility = [
        "//k8s:__pkg__",
        "//tests:__pkg__",
    ],
)

filegroup(
    name = "hermes_seed",
    srcs = [
        "templates/coder-spark-lab/hermes-seed/SOUL.md",
        "templates/coder-spark-lab/hermes-seed/config.yaml",
        "templates/coder-spark-lab/hermes-seed/distribution.yaml",
        "templates/coder-spark-lab/hermes-seed/mcp.json",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "images",
    srcs = [
        "images/coder-workspace/workspace-init.sh",
        "images/kasm-spark-desktop/custom_startup.sh",
    ],
    visibility = ["//visibility:public"],
)
