"""Package purpose: Base namespace, resource-guard, kustomization, and GPU time-slicing manifests."""

"""Base Kubernetes resources."""

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "namespace",
    srcs = ["namespace.yaml"],
    visibility = [
        "//k8s:__subpackages__",
        "//lints:__pkg__",
        "//scripts:__pkg__",
        "//tests:__pkg__",
    ],
)

filegroup(
    name = "resource_guard",
    srcs = [
        "namespaces-dev.yaml",
        "namespaces-sso.yaml",
        "resource-guard/limit-ranges.yaml",
        "resource-guard/pod-disruption-budgets.yaml",
        "resource-guard/priority-classes.yaml",
        "resource-guard/resource-quotas.yaml",
    ],
    visibility = [
        "//k8s:__pkg__",
        "//tests:__pkg__",
    ],
)

filegroup(
    name = "kustomization",
    srcs = [
        "README.md",
        "kustomization.yaml",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "gpu_time_slicing",
    srcs = [
        "gpu-time-slicing/README.md",
        "gpu-time-slicing/any.yaml",
        "gpu-time-slicing/kustomization.yaml",
    ],
    visibility = ["//visibility:public"],
)
