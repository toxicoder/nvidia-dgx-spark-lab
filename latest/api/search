":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"control-plane + worker"},"4506":{"id":"/start/choose-topology-70","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"two workers"},"4507":{"id":"/start/choose-topology-71","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"QSFP **ring** 200 Gb/s per pair"},"4508":{"id":"/start/choose-topology-72","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"**4**"},"4509":{"id":"/start/choose-topology-73","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"control-plane + worker"},"4510":{"id":"/start/choose-topology-74","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"three workers"},"4511":{"id":"/start/choose-topology-75","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"CRS804, full QSFP-DD ports"},"4512":{"id":"/start/choose-topology-76","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"**5**"},"4513":{"id":"/start/choose-topology-77","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nv