nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#contributing-to-the-documentation","content":"Guidelines for contributing docs, code comments, and generated content"},"196":{"id":"/CONTRIBUTING-13","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#contributing-to-the-documentation","content":"Rich formatting requirements"},"197":{"id":"/CONTRIBUTING-14","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#contributing-to-the-documentation","content":"Process for shell reference, visuals, etc."},"198":{"id":"/CONTRIBUTING-15","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#contributing-to-the-documentation","content":"Keeping docs as code (never stale)"},"199":{"id":"/CONTRIBUTING-16","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#contributing-to-the-documentation","content":"Consistent experience across the site and generated refs"},"200":{"id":"/CONTRIBUTING-17","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#contributing-to-the-documentation","content":"For code, shell, Kubernetes, Ansible, config, and dashboard conventions, see project-conventions.md. The repo-root CONTRIBUTING.md is the short contribution hub."},"201":{"id":"/CONTRIBUTING-18","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#contributing-to-the-documentation","content":"Thank you for helping improve the documentation for nvidia-dgx-spark-lab!"},"202":{"id":"/CONTRIBUTING-19","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#contributing-to-the-documentation","content":"All changes to documentation must follow the same rigor as code changes."},"203":{"id":"/CONTRIBUTING-20","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#quick-start","content":"Bazel (primary):"},"204":{"id":"/CONTRIBUTING-21","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#quick-start","content":"The docs targets install missing npm dependencies on first run, so a fresh clone needs no separate setup step."},"205":{"id":"/CONTRIBUTING-22","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#quick-start","content":"Inside `docs-site/` the same things are npm scripts: `npm run dev`, `npm run build`,\n`npm run visual`, `npm run nav:check`.  Screenshot baselines are refreshed with\n`bazelisk run //docs-site:visual-linux -- --update` (needs Docker), which renders them in the\nLinux image that matches the docs CI job — never on a laptop.  See `bazelisk run //docs:status`\nor the `--help` output for all options."},"206":{"id":"/CONTRIBUTING-23","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"Sidebar groups live in `docs-site/lib/nav.json`, transcribed once from the former\n`mkdocs.yml` nav.  That file is gone, so `nav.json` is the source of truth: edit it by hand\nand verify with `bazelisk test //docs-site:nav_test` (which fails if an entry has no page on disk).  The\ngroups are:"},"207":{"id":"/CONTRIBUTING-24","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"**Home** — path cards, default stack, safety table"},"208":{"id":"/CONTRIBUTING-25","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"**Start** — gold path, topology, profiles, learn-the-lab"},"209":{"id":"/CONTRIBUTING-26","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"**Concepts** — architecture, NCCL, Resource Guard, stacks, glossary"},"210":{"id":"/CONTRIBUTING-27","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"**Operate** — catalogs, dashboard, runbooks, troubleshooting"},"211":{"id":"/CONTRIBUTING-28","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"**Reference** — project conventions, docs contributing, generated shell + dashboard API"},"212":{"id":"/CONTRIBUTING-29","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"**Contribute** — dev environment, Bazel"},"213":{"id":"/CONTRIBUTING-30","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"Every major section has an `index.md`. Keep existing published slugs (`getting-started`,\n`architecture`, …): the route is the file path without its extension, so renaming a file\nbreaks every bookmark and README link to it. Put **new** pages under `start/`, `learn/`,\n`concepts/`, `operate/`, `contribute/`."},"214":{"id":"/CONTRIBUTING-31","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"A new page needs three things or it will not appear in the sidebar and the coverage gate\nfails: the file under `docs/`, an entry in the nav (see above), and a listing in\n`_HAND_WRITTEN_MD` in `docs/BUILD.bazel` so Bazel ships it as a runfile."},"215":{"id":"/CONTRIBUTING-32","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#information-architecture","content":"Use the right-hand ToC for long pages. Keep navigation focused."},"216":{"id":"/CONTRIBUTING-33","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#content-guidelines","content":"Every page must open (after the title or any intentional top widget such as the interactive panel) with a scannable overview in this bullet-point format:\n**What's on this page**"},"217":{"id":"/CONTRIBUTING-34","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#content-guidelines","content":"Bullets describing the main content, sections, diagrams, tables, etc.\n**What this enables / practical use**"},"218":{"id":"/CONTRIBUTING-35","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#content-guidelines","content":"Bullets describing reader benefit, common use cases, or what the content lets you achieve.\nWrite those labels as bold markdown plus lists, not as JSX. The site wraps the first pair into a two-column panel; later examples on the same page stay ordinary prose."},"219":{"id":"/CONTRIBUTING-36","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#content-guidelines","content":"Write for humans. Be concise. Remove filler."},"220":{"id":"/CONTRIBUTING-37","page_id":"/CONTRIBUTING","tags":["documentation","contributing","fumadocs","nextjs","bazel"],"type":"text","url":"/CONTRIBUTING#content-guidelines","c