m","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#litellm-rounded-stack-3-dgx-spark","content":"One OpenAI base URL for chat clients"},"1180":{"id":"/litellm-rounded-stack-23","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#litellm-rounded-stack-3-dgx-spark","content":"Nothing auto-starts on reboot. Heavy Jobs are `OnFailure` + `backoffLimit: 1` with explicit resources. Resource Guard 15% / **24Gi** headroom applies. Mode A vLLM util ≤ 0.82; Mode B exclusive vLLM util ≤ 0.85; Mode C exclusive SGLang `--mem-fraction-static` ≤ 0.95. Never ship vLLM 0.88/0.90."},"1181":{"id":"/litellm-rounded-stack-24","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"Three DGX Spark GB10 nodes (128 GB UMA, sm\\_121). Two networks — never mix roles:"},"1182":{"id":"/litellm-rounded-stack-25","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"Plane"},"1183":{"id":"/litellm-rounded-stack-26","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"Typical names"},"1184":{"id":"/litellm-rounded-stack-27","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"Carries"},"1185":{"id":"/litellm-rounded-stack-28","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"LAN / management (RJ-45 10GbE)"},"1186":{"id":"/litellm-rounded-stack-29","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"often `enP7s7`"},"1187":{"id":"/litellm-rounded-stack-30","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"K3s, SSH, dashboard, LiteLLM, Open WebUI, NCCL bootstrap / Gloo"},"1188":{"id":"/litellm-rounded-stack-31","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"High-speed fabric (CX-7 RoCE)"},"1189":{"id":"/litellm-rounded-stack-32","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"four RoCE twins per node"},"1190":{"id":"/litellm-rounded-stack-33","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"NCCL payload / TP all-reduce **only**"},"1191":{"id":"/litellm-rounded-stack-34","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#3-node-qsfp-ring-mode-b-and-mode-c","content":"200 Gb/s per physical port (not 400G, not NVLink, not InfiniBand switch). Triangle mesh: every pair has a direct cable."},"1192":{"id":"/litellm-rounded-stack-35","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#3-node-qsfp-ring-mode-b-and-mode-c","content":"Port0 = cage next to the RJ-45 jack; Port1 = far cage. Wrong polarity looks half-alive and dies in NCCL. MTU 9000 on CX-7. All four CX-7 netdevs per node need IPs (six unique /24s). Confirm live names with `ibdev2netdev` before baking env."},"1193":{"id":"/litellm-rounded-stack-36","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#3-node-qsfp-ring-mode-b-and-mode-c","content":"**Mode B / Mode C NCCL** (these Jobs only — do not copy 2-node pair vars):"},"1194":{"id":"/litellm-rounded-stack-37","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#3-node-qsfp-ring-mode-b-and-mode-c","content":"If 10GbE is not `enP7s7`, set `LAB_MGMT_IFNAME`. Do not hard-fail the stack on that string. `ansible/inventory/group_vars/all.yml` `highspeed_*` is the **2-node pair** reference."},"1195":{"id":"/litellm-rounded-stack-38","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#3-node-qsfp-ring-mode-b-and-mode-c","content":"K3s/Flannel stay on the LAN. Mode B and Mode C Jobs use `hostNetwork: true` and `hostIPC: true`. Realistic ring bus is \\~12–24 GB/s allgather. Optional GB10 UMA livelock fallback (not default): `NCCL_NET_GDR_LEVEL=0`. Mode C also sets NCCL buffer cuts (`NCCL_BUFFSIZE=1MiB`) so pinned host RAM does not eat the head."},"1196":{"id":"/litellm-rounded-stack-39","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#