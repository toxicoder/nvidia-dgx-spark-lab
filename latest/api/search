ource limits, per-topology NCCL interconnect (pair, ring, CRS804 switch), GPU Operator on K3s, stability tips, and recommended workflow."},"662":{"id":"/dgx-spark-notes-1","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"DGX Spark Specific Notes"},"663":{"id":"/dgx-spark-notes-2","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#resource-management-is-critical","content":"Resource Management is Critical"},"664":{"id":"/dgx-spark-notes-3","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"Preventing Auto-Restart on Reboot"},"665":{"id":"/dgx-spark-notes-4","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#high-speed-interconnect","content":"High-Speed Interconnect"},"666":{"id":"/dgx-spark-notes-5","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"hostNetwork and hostIPC"},"667":{"id":"/dgx-spark-notes-6","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#ple-mmap-qwen38-flash-next","content":"PLE mmap (Qwen3.8-Flash-Next)"},"668":{"id":"/dgx-spark-notes-7","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"GPU Operator on K3s"},"669":{"id":"/dgx-spark-notes-8","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"Dual concurrent models (time-slicing)"},"670":{"id":"/dgx-spark-notes-9","page_id":"/dgx-spa