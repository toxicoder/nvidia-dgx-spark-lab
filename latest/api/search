","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#3-node-qsfp-ring-mode-b-and-mode-c","content":"K3s/Flannel stay on the LAN. Mode B and Mode C Jobs use `hostNetwork: true` and `hostIPC: true`. Realistic ring bus is \\~12–24 GB/s allgather. Optional GB10 UMA livelock fallback (not default): `NCCL_NET_GDR_LEVEL=0`. Mode C also sets NCCL buffer cuts (`NCCL_BUFFSIZE=1MiB`) so pinned host RAM does not eat the head."},"1209":{"id":"/litellm-rounded-stack-38","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"Node"},"1210":{"id":"/litellm-rounded-stack-39","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"Job"},"1211":{"id":"/litellm-rounded-stack-40","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"Checkpoint"},"1212":{"id":"/litellm-rounded-stack-41","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"Aliases"},"1213":{"id":"/litellm-rounded-stack-42","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"spark0"},"1214":{"id":"/litellm-rounded-stack-43","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"existing `qwen3.6-35b-a3b-nvfp4`"},"1215":{"id":"/litellm-rounded-stack-44","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"Unsloth NVFP4-Fast, MTP, `flashinfer_b12x`"},"1216":{"id":"/litellm-rounded-stack-45","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"`lab-fast`, `lab-code`"},"1217":{"id":"/litellm-rounded-stack-46","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"spark1"},"1218":{"id":"/litellm-rounded-stack-47","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"`qwen3.8-flash-next-nvfp4`"},"1219":{"id":"/litellm-rounded-stack-48","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"`RadixArk/Qwen3.8-Flash-Next-NVFP4`, PLE mmap, image `vllm/vllm-openai:qwen38-flash-next`"},"1220":{"id":"/litellm-rounded-stack-49","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"`lab-smart`, `lab-agent`"},"1221":{"id":"/litellm-rounded-stack-50","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"spark2"},"1222":{"id":"/litellm-rounded-stack-51","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"`medgemma-27b`"},"1223":{"id":"/litellm-rounded-stack-52","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"`google/medgemma-27b-multimodal`, FP8 on `cu130-nightly`"},"1224":{"id":"/litellm-rounded-stack-53","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"`lab-med`, `lab-med-vision`"},"1225":{"id":"/litellm-rounded-stack-54","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"Mode A is TP=1. The ring is unused for tokens. 35B is pinned to spark0 **only** via the rounded overlay so 1-node exclusive/dual still works."},"1226":{"id":"/litellm-rounded-stack-55","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"Qwen3.8-Flash-Next: start `max-model-len` 65536; document 262144. Prefix caching off. PLE mmap is mandatory."},"1227":{"id":"/litellm-rounded-stack-56","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"`--quality` loads existing `qwen3.6-27b-nvfp4` on spark2 (`lab-quality`). `lab-med` then falls back to `lab-smart` with a medical system prompt (not MedGemma)."},"1228":{"id":"/litellm-rounded-stack-57","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"Optional `medgemma-4b` sidecar (`lab-med-extract`) is **off by default**. Enable only after Resource Guard says there is GPU headroom. Never treat 4B as the only medical model."},"1229":{"id":"/litellm-rounded-stack-58","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-a--daily-mixed-fleet-default","content":"Documented Apache-2 swap if HAI-DEF is a problem: Baichuan-M2-32B (docs only). Do not default to OpenBioLLM-8B or Meditron-7B."},"1230":{"id":"/litellm-rounded-stack-59","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-b--exclusive-frontier-uses-the-ring","content":"`glm-5.3-flash` leader on spark0 + workers on spark1/spark2. Image `glm53-flash-tp3:local` built on Spark from the published TP=3 overlay (stock nightly cannot do TP=3). Checkpoint `local-inference-lab/GLM-5.3-Flash-NVFP4` (or RedHatAI). MTP default; DFlash2 is CC BY-NC-ND and is not the default."},"1231":{"id":"/litellm-rounded-stack-60","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-b--exclusive-frontier-uses-the-ring","content":"`start-stack-rounded`, `start-glm53-flash`, and `start-dsv41-flash` refuse each other. The DSpark pair, the GLM EXL3 TensorFold pair, and the three Qwen TensorFold lanes refuse all of these and each other. Heavy confirm. `lab-frontier` stays GLM; `lab-med` falls back to `lab-smart`, then `lab-frontier`, then `lab-frontier-ds` with an explicit prompt that MedGemma is offline and this is a general model."},"1232":{"id":"/litellm-rounded-stack-61","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#recover-when-modes-collide","content":"`bazelisk run //:manage -- status-stack` — see which Jobs exist."},"1233":{"id":"/litellm-rounded-stack-62","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#recover-when-modes-collide","content":"Stop **only** the mode that is up:"},"1234":{"id":"/litellm-rounded-stack-63","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#recover-when-modes-collide","content":"`doctor` then start **one** lane: A, B, C, or one of the DSpark / TensorFold exclusive lanes."},"1235":{"id":"/litellm-rounded-stack-64","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#recover-when-modes-collide","content":"LiteLLM Deployment can stay; aliases 503 until the matching backend Job is Ready."},"1236":{"id":"/litellm-rounded-stack-65","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#recover-when-modes-collide","content":"Do not run two exclusive TP=3 Jobs “to compare.” The ring and 24Gi floor will not fit."},"1237":{"id":"/litellm-rounded-stack-66","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#recover-when-modes-collide","content":"Mode B exclusive util is **0.85**. 0.88 is not shipped. First `max-model-len` is 131072."},"1238":{"id":"/litellm-rounded-stack-67","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#recover-when-modes-collide","content":"Do not add GLM 753B as a daily driver. Existing `glm-5.2` 1-bit RPC stays as optional night mode."},"1239":{"id":"/litellm-rounded-stack-68","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-c--exclusive-deepseek-v41-flash-uses-the-ring","content":"Official `deepseek-ai/DeepSeek-V4.1-Flash` only (native MXFP4 experts + FP8/MXFP8 dense). **Do not** use `nvidia/DeepSeek-V4-Flash-NVFP4` (old 284B) or LibertAIDAI requants. DeepSeek-V4.1 / V4.1-Pro weights are **not published** — do not invent a non-Flash V4.1 Job."},"1240":{"id":"/litellm-rounded-stack-69","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-c--exclusive-deepseek-v41-flash-uses-the-ring","content":"Engine is **SGLang** with the MiaAI-Lab GB10 overlay (`dsv41-flash-tp3:local`), not stock vLLM. Engram tables live on **each node’s NVMe** at `/mnt/models/dsv41-engram`. `OFFLOAD_MODE=nvme` only — RAM offload evicts the model on UMA."},"1241":{"id":"/litellm-rounded-stack-70","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-c--exclusive-deepseek-v41-flash-uses-the-ring","content":"`PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False` (True NaNs V4.1 prompts >64 tokens). Do not copy the Comfy visual `True` patch."},"1242":{"id":"/litellm-rounded-stack-71","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-c--exclusive-deepseek-v41-flash-uses-the-ring","content":"First profile: `--mem-fraction-static 0.95` (MiaAI measured load for \\~101 GiB/rank), `--context-length 131072`, `--max-running-requests 1`. Hang line is MemAvailable \\~8–12 GiB; MiaAI left \\~6 GiB on the head. If MemAvailable drops below 8 GiB, `stop-dsv41-flash`. Job is fail-stop (`OnFailure` + `backoffLimit: 1`); nothing auto-starts on reboot."},"1243":{"id":"/litellm-rounded-stack-72","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-c--exclusive-deepseek-v41-flash-uses-the-ring","content":"Same 3-node QSFP NCCL block as Mode B, plus NCCL buffer cuts. Master port **29522**. TP=3 head padding 64→96 is expected (overlay). A 4th Spark → TP=4 overlay is documented future work, not this tree."},"1244":{"id":"/litellm-rounded-stack-73","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#mode-c--exclusive-deepseek-v41-flash-uses-the-ring","content":"Image overlay is AGPL-3.0; this repo does not vendor `adapter/`. See `k8s/workloads/deepseek-v4.1-flash/README.md`."},"1245":{"id":"/litellm-rounded-stack-74","page_id":"/litellm-rounded-stack"