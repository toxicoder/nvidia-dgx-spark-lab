,"nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#litellm-rounded-stack-3-dgx-spark","content":"One OpenAI base URL for chat clients"},"1190":{"id":"/litellm-rounded-stack-21","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#litellm-rounded-stack-3-dgx-spark","content":"Nothing auto-starts on reboot. Heavy Jobs are `OnFailure` + `backoffLimit: 1` with explicit resources. Resource Guard 15% / **24Gi** headroom applies. Mode A vLLM util ≤ 0.82; Mode B exclusive vLLM util ≤ 0.85; Mode C exclusive SGLang `--mem-fraction-static` ≤ 0.95. Never ship vLLM 0.88/0.90."},"1191":{"id":"/litellm-rounded-stack-22","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"Three DGX Spark GB10 nodes (128 GB UMA, sm\\_121). Two networks — never mix roles:"},"1192":{"id":"/litellm-rounded-stack-23","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"Plane"},"1193":{"id":"/litellm-rounded-stack-24","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"Typical names"},"1194":{"id":"/litellm-rounded-stack-25","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","glm","deepseek","dgx-spark","nccl"],"type":"text","url":"/litellm-rounded-stack#hardware","content":"Carries"},"1195":{"id":"/litellm-rounded-stack-26","page_id":"/litellm-rounded-stack","tags":["litellm","inference","nvfp4","vllm","sglang","medgemma","g