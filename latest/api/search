nventions#formatter-settings","content":"`*.sh`"},"2242":{"id":"/project-conventions-259","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"`-w -s -i 2 -ci` (2-space indent, simplify, indent case); check via `//lints:shfmt`"},"2243":{"id":"/project-conventions-260","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"**ruff**"},"2244":{"id":"/project-conventions-261","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"`docs/*.py`, root `*.py`"},"2245":{"id":"/project-conventions-262","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"format + `check --fix`"},"2246":{"id":"/project-conventions-263","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"**mypy**"},"2247":{"id":"/project-conventions-264","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"all tracked `*.py`"},"2248":{"id":"/project-conventions-265","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"`strict = true` per `mypy.ini`; `//lints:mypy` (manual)"},"2249":{"id":"/project-conventions-266","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"**prettier**"},"2250":{"id":"/project-conventions-267","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"dashboard TS/TSX/MD/JSON; repo YAML via `//:fix`"},"2251":{"id":"/project-conventions-268","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"2-space, 120 cols, double quotes (`prettier.config.mjs`)"},"2252":{"id":"/project-conventions-269","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"**eslint**"},"2253":{"id":"/project-conventions-270","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"dashboard"},"2254":{"id":"/project-conventions-271","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatter-settings","content":"`no-explicit-any: error`; Next core-web-vitals"},"2255":{"id":"/project-conventions-272","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#yaml-linting","content":"`.yamllint.yml`: 2-space indent, 120-char line length (warning), `document-start: disable`. Helm templates and Jinja (`.j2`) are excluded."},"2256":{"id":"/project-conventions-273","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#pre-commit-optional","content":"Hooks mirror Bazel lint tools: buildifier check, shfmt, shellcheck, prettier YAML, yamllint. See `.pre-commit-config.yaml`."},"2257":{"id":"/project-conventions-274","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#typescript-dashboard","content":"`strict: true` plus the flags in Strong Types: `noUncheckedIndexedAccess`, `exactOptionalPropertyTypes`, `noImplicitOverride`, `noImplicitReturns`, `noUnusedLocals`, `useUnknownInCatchVariables`"},"2258":{"id":"/project-conventions-275","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#typescript-dashboard","content":"Path alias: `@/*` → dashboard root"},"2259":{"id":"/project-conventions-276","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#typescript-dashboard","content":"No explicit `any` (ESLint error), alongside the type-aware `no-unsafe-*` family, which needs `parserOptions.projectService` to run at all"},"2260":{"id":"/project-conventions-277","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#5b-strong-types","content":"Full reference: Strong Types. The rules contributors hit most often:"},"2261":{"id":"/project-conventions-278","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#5b-strong-types","content":"**Broad types are defects.** `Any` in Python, `any`/`unknown`/`Record<string, unknown>` in TypeScript, and bare `dict`/`list`/`tuple`/`set` are gate failures, not style opinions. Where a value is genuinely opaque, use `object` (or `unknown`) and say why in a comment on that line."},"2262":{"id":"/project-conventions-279","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#5b-strong-types","content":"**Closed sets are declared once.** An `as const` array in `dashboard/lib/types/index.ts` or a `StrEnum` in `scripts/lib/py/lab_types.py` is the source; the derived type and the zod/allowlist counterpart read from it. Never re-list a set in two places."},"2263":{"id":"/project-conventions-280","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#5b-strong-types","content":"**Validate at the boundary.** JSON crossing from a shell utility into the dashboard is parsed with a zod schema in `dashboard/lib/services/cli-json.ts`, never cast. Python reads shapeless JSON through `typing.cast` to a `TypedDict` when a filter would change behaviour."},"2264":{"id":"/project-conventions-281","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#5b-strong-types","content":"**Shell parameters get a contract.** Repo-bound scripts source `scripts/lib/types.sh` and call `require_*`; a failure writes one diagnostic to stderr naming the parameter."},"2265":{"id":"/project-conventions-282","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#5b-strong-types","content":"**A gate that inspected nothing must fail.** Find-nothing is an error, not a pass. `//lints:mypy` and `//lints:yaml_format` both passed for a long time having examined zero files."},"2266":{"id":"/project-conventions-283","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#6-shell-scripts","content":"This section is the lab’s **adapted professional Bash style guide**. It synthesizes Google’s Shell Style Guide, ShellCheck, shfmt, and bats-core practice, tailored to Bazel, kcov, and the generated shell reference."},"2267":{"id":"/project-conventions-284","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Principle"},"2268":{"id":"/project-conventions-285","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Lab practice"},"2269":{"id":"/project-conventions-286","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Readability first**"},"2270":{"id":"/project-conventions-287","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Prefer clarity over clever one-liners"},"2271":{"id":"/project-conventions-288","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Small, focused functions**"},"2272":{"id":"/project-conventions-289","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"One responsibility; extract aggressively"},"2273":{"id":"/project-conventions-290","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Fail fast and loudly**"},"2274":{"id":"/project-conventions-291","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"`set -euo pipefail` on entry scripts; never continue in a broken state"},"2275":{"id":"/project-conventions-292","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Explicit over implicit**"},"2276":{"id":"/project-conventions-293","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Quote expansions; name locals; document public APIs"},"2277":{"id":"/project-conventions-294","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Testable by design**"},"2278":{"id":"/project-conventions-295","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Libs are sourceable; entry scripts use thin `main` + source guards"},"2279":{"id":"/project-conventions-296","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**ShellCheck is mandatory**"},"2280":{"id":"/project-conventions-297","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Warnings are defects until fixed or justified with a comment"},"2281":{"id":"/project-conventions-298","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Consistency**"},"2282":{"id":"/project-conventions-299","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"shfmt + this section beat personal taste"},"2283":{"id":"/project-conventions-300","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**When to use Bash:** orchestration, thin wrappers, cluster ops (`manage.sh`, utilities). Prefer Python (or another language) when a *new* piece needs complex data structures, non-trivial algorithms, or would be hard to unit-test in shell."},"2284":{"id":"/project-conventions-301","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Lab exception (scale):** modular domain libraries under `scripts/lib/` may exceed \\~100 lines because they are the operational surface. That is intentional—do not grow a single file with spaghetti; split domains instead. Do **not** rewrite `manage.sh` to Python without an explicit project decision."},"2285":{"id":"/project-conventions-302","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Every **executable** entry script starts with:"},"2286":{"id":"/project-conventions-303","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Prefer `#!/usr/bin/env bash` (portability) over Google’s `#!/bin/bash`."},"2287":{"id":"/project-conventions-304","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Optional: `set -Eeuo pipefail` when you install an `ERR` trap that must inherit into functions."},"2288":{"id":"/project-conventions-305","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Optional: `IFS=$'\\n\\t'` only when the script benefits; do not change IFS globally in libs without care."},"2289":{"id":"/project-conventions-306","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"**Libraries** (`scripts/lib/*.sh`) are *sourced* and intentionally omit `set -euo`—they inherit the caller’s options."},"2290":{"id":"/project-conventions-307","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Resolve paths with project helpers (kcov-safe), not only raw `BASH_SOURCE`:"},"2291":{"id":"/project-conventions-308","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Source `lib/common.sh` for `log`, `warn`, `err`, `die`, and shared helpers. Utilities may redefine logging with a utility-specific prefix (e.g. `[spark-clock]`), still on **stderr**."},"2292":{"id":"/project-conventions-309","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#canonical-skeleton","content":"**Entry script** (utility or standalone tool):"},"2293":{"id":"/project-conventions-310","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#canonical-skeleton","content":"**Library** (`scripts/lib/*.sh`): `# ##` header, `# @function` on every function, no top-level `main \"$@\"`, minimal side effects beyond defaults / soft path setup."},"2294":{"id":"/project-conventions-311","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Rule"},"2295":{"id":"/project-conventions-312","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Value"},"2296":{"id":"/project-conventions-313","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Indent"},"2297":{"id":"/project-conventions-314","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"2 spaces, no tabs (except `<<-` heredocs)"},"2298":{"id":"/project-conventions-315","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"shfmt"},"2299":{"id":"/project-conventions-316","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"`shfmt -w -s -i 2 -ci` (`//:fix`) / check: `//lints:shfmt`"},"2300":{"id":"/project-conventions-317","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Conditionals"},"2301":{"id":"/project-conventions-318","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"`[[ … ]]` preferred over `[` / `test`"},"2302":{"id":"/project-conventions-319","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Command sub"},"2303":{"id":"/project-conventions-320","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"`$(…)` not backticks"},"2304":{"id":"/project-conventions-321","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel