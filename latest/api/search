a-ci-setup#caching--parallelism-tips-for-gitea","content":"Docs **build** in CI: `bazelisk run //docs:docs --config=ci` then `bazelisk run //docs-site:visual --config=ci` (same as GitHub); the visual job needs the Chromium that `npx playwright install` provides in the runner image or cache. Publish remains GitHub-only today."},"861":{"id":"/glossary","page_id":"/glossary","type":"page","content":"Glossary","breadcrumbs":["Docs"],"tags":["glossary","concepts","education"],"url":"/glossary"},"862":{"id":"/glossary-0","page_id":"/glossary","tags":["glossary","concepts","education"],"type":"text","url":"/glossary","content":"Lab terminology with short definitions and links to deeper concept pages — educational companion to in-page tooltips."},"863":{"id":"/glossary-1","page_id":"/glossary","type":"heading","tags":["glossary","concepts","education"],"url":"/glossary#glossary","content":"Glossary"},"864":{"id":"/glossary-2","page_id":"/glossary","type":"heading","tags":["glossary","concepts","education"],"url":"/glossary#core-lab-concepts","content":"Core lab concepts"},"865":{"id":"/glossary-3","page_id":"/glossary","type":"heading","tags":["glossary","concepts","education"],"url":"/glossary#cluster--platform","content":"Cluster & platform"},"866":{"id":"/glossary-4","page_id":"/glossary","type":"heading","tags":["glossary","concepts","education"],"url":"/glossary#workloads--parallelism","content":"Workloads & parallelism"},"867":{"id":"/glossary-5","page_id":"/glossary","type":"heading","tags":["glossary","concepts","education"],"url":"/glossary#storage--config","content":"Storage & config"},"868":{"id":"/glossary-6","page_id":"/glossary","type":"heading","tags":["glossary","concepts","education"],"url":"/glossary#agents--ui","content":"Agents & UI"},"869":{"id":"/glossary-7","page_id":"/glossary","type":"heading","tags":["glossary","concepts","education"],"url":"/glossary#tooling","content":"Tooling"},"870":{"id":"/glossary-8","page_id":"/glossary","type":"heading","ta