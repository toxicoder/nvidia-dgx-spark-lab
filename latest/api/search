":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#high-speed-interconnect","content":"High-Speed Interconnect"},"653":{"id":"/dgx-spark-notes-5","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"hostNetwork and hostIPC"},"654":{"id":"/dgx-spark-notes-6","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#ple-mmap-qwen38-flash-next","content":"PLE mmap (Qwen3.8-Flash-Next)"},"655":{"id":"/dgx-spark-notes-7","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"GPU Operator on K3s"},"656":{"id":"/dgx-spark-notes-8","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"Dual concurrent models (time-slicing)"},"657":{"id":"/dgx-spark-notes-9","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#blackwell-nvfp4-kernels","content":"Blackwell NVFP4 kernels"},"658":{"id":"/dgx-spark-notes-10","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#stability-tips","content":"Stability Tips"},"659":{"id":"/dgx-spark-notes-11","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#recommended-workflow","content":"Recommended Workflow"},"660":{"id":"/dgx-spark-notes-12","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#common-failure-modes","content":"Common Failure Modes"},"661":{"id":"/dgx-spark-notes-13","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"**What's on this page**"},"662":{"id":"/dgx-spark-notes-14","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Resource management rules critical for large models on DGX Spark hardware"},"663":{"id":"/dgx-spark-notes-15","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Reboot safety procedures and prevention of auto-restarts"},"664":{"id":"/dgx-spark-notes-16","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"High-speed interconnect per topology (pair, ring, CRS804 switch) and required NCCL settings"},"665":{"id":"/dgx-spark-notes-17","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"GPU Operator and K3s specifics for this platform"},"666":{"id":"/dgx-spark-notes-18","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Stability tips and common failure modes"},"667":{"id":"/dgx-spark-notes-19","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Recommended overall workflow"},"668":{"id":"/dgx-spark-notes-20","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"**What this enables**"},"669":{"id":"/dgx-spark-notes-21","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Keeping nodes responsive and SSH usable when running 70B+ and MoE models"},"670":{"id":"/dgx-spark-notes-22","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Applying the exact practices used by this lab for production inference"},"671":{"id":"/dgx-spark-notes-23","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Avoiding situations that make the host unusable or require long recovery"},"672":{"id":"/dgx-spark-notes-24","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Large models (70B+, MoE like Kimi-K2.6) can quickly exhaust host memory and make the node unresponsive over SSH."},"673":{"id":"/dgx-spark-notes-25","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"**Rules:**"},"674":{"id":"/dgx-spark-notes-26","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Always set `resources.requests` and `resources.limits` for both CPU and memory, not just GPU."},"675":{"id":"/dgx-spark-notes-27","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Use `restartPolicy: OnFailure` with `backoffLimit: 1` for heavy jobs."},"676":{"id":"/dgx-spark-notes-28","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Prefer Jobs over Deployments for one-shot or long-running inference servers that you control explicitly."},"677":{"id":"/dgx-spark-notes-29","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Never use `imagePullPolicy: Always` on multi-hundred-GB images."},"678":{"id":"/dgx-spark-notes-30","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"We do **not** use Deployments with high replica counts for heavy models."},"679":{"id":"/dgx-spark-notes-31","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"We do **not** use `restartPolicy: Always` for the main inference container."},"680":{"id":"/dgx-spark-notes-32","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"Workloads are started manually via `scripts/manage.sh`."},"681":{"id":"/dgx-spark-notes-33","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"After reboot you must explicitly re-deploy."},"682":{"id":"/dgx-spark-notes-34","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"No inter-node NCCL. Local multi-GPU (if advertised) uses SHM/P2P, and the `highspeed`\ninventory group is ignored."},"683":{"id":"/dgx-spark-notes-35","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"**2-node pair (one 200 Gb/s QSFP cable):** existing Jobs and `group_vars` `highspeed_*` /\n`nccl_env` are **reference for a pair**. Typical env:"},"684":{"id":"/dgx-spark-notes-36","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"**3-node QSFP ring (200 Gb/s per pair, triangle mesh):** used by Mode B (`glm-5.3-flash`)\nand Mode C (`deepseek-v4.1-flash`). OOB/Gloo on 10GbE (often `enP7s7`); payload on all\nfour CX-7 RoCE devices; `NCCL_NET_PLUGIN=none`. Do **not** copy the 2-node pair vars onto\nthat ring. Confirm names with `ibdev2netdev`. See LiteLLM rounded stack."},"685":{"id":"/dgx-spark-notes-37","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"**4 / 5-node CRS804 switch:** each node sees **one** RoCE link — one full port per node\n(Spark CX-7 at 200 Gb/s) for 4 nodes, or three full ports plus one 400G QSFP-DD port split\ninto `sfpplus4a` / `sfpplus4b` (two 200G lanes) for 5. Every link is its own /24 (192.168.110–114, MTU 9000) from the\ngenerated per-node netplan. `NCCL_SOCKET_IFNAME` stays the management NIC; the payload\nrides the single RoCE HCA (`NCCL_IB_HCA` from live `ibdev2netdev` names per node). Heavy\nJobs use `hostNetwork: true` — do not assume the 2-node pair `NCCL_SOCKET_IFNAME` list is\ncomplete. Cabling and port map: Choose topology."},"686":{"id":"/dgx-spark-notes-38","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"If NCCL payload falls back to the management network, performance will be terrible."},"687":{"id":"/dgx-spark-notes-39","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"Full fabric env: Interconnect & NCCL."},"688":{"id":"/dgx-spark-notes-40","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"**Omitted** (default false) on kimi / kimi-test and several 1-GPU vLLM Jobs — isolation; NCCL IFNAME still set in env."},"689":{"id":"/dgx-spark-notes-41","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"**`hostNetwork: true`** on Ray, GLM-5.2, Qwen 397B, Mode B/C — ranks need the fabric NICs."},"690":{"id":"/dgx-spark-notes-42","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"**`hostIPC: true`** on GLM RPC and Mode B/C ring Jobs — shared memory for TP."},"691":{"id":"/dgx-spark-notes-43","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"Do not add hostNetwork to a Job “for luck”; follow the workload YAML."},"692":{"id":"/dgx-spark-notes-44","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#ple-mmap-qwen38-flash-next","content":"Mode A `qwen3.8-flash-next-nvfp4` requires PLE mmap (weights mapped, not fully resident). Prefix caching off. Start `max-model-len` 65536. See LiteLLM rounded stack."},"693":{"id":"/dgx-spark-notes-45","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#ple-mmap-qwen38-flash-next","content":"Verify interfaces on the nodes:"},"694":{"id":"/dgx-spark-notes-46","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"The NVIDIA GPU Operator works well on K3s but:"},"695":{"id":"/dgx-spark-notes-47","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"Use a recent version (v24.x+ recommended)."},"696":{"id":"/dgx-spark-notes-48","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"The driver container may take several minutes to load after first boot."},"697":{"id":"/dgx-spark-notes-49","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"On reboot, wait for `nvidia-smi` to succeed on both nodes before deploying heavy workloads."},"698":{"id":"/dgx-spark-notes-50","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"MIG is supported but requires explicit configuration in the ClusterPolicy."},"699":{"id":"/dgx-spark-notes-51","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"A single GB10 exposes **one** physical GPU. To schedule two inference Jobs concurrently (e.g. Qwen3.6 dual):"},"700":{"id":"/dgx-spark-notes-52","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"Apply `k8s/base/gpu-time-slicing` (`replicas: 2`)."},"701":{"id":"/dgx-spark-notes-53","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"Point the device plugin at that ConfigMap (`gpu_time_slicing_enabled: true` in Ansible, or helm upgrade)."},"702":{"id":"/dgx-spark-notes-54","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"Split memory with `--gpu-memory-utilization` (\\~0.38 each). Never run two processes at 0.9 util."},"703":{"id":"/dgx-spark-notes-55","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"See qwen36-dual-stack.md."},"704":{"id":"/dgx-spark-notes-56","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#blackwell-nvfp4-kernels","content":"On DGX Spark, set `CUTE_DSL_ARCH=sm_121a`. For MoE NVFP4, use `--moe-backend flashinfer_b12x` or inference can be \\~2–2.5× slower (Marlin fallback)."},"705":{"id":"/dgx-spark-notes-57","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"Reserve headroom: leave at least 10-20% of host RAM and CPU free for the system + K3s."},"706":{"id":"/dgx-spark-notes-58","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"Use node affinity so that heavy inference prefers specific nodes if needed."},"707":{"id":"/dgx-spark-notes-59","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"Monitor with:"},"708":{"id":"/dgx-spark-notes-60","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"If SSH becomes laggy, the node is likely OOMing. Hard power cycle may be required in extreme cases."},"709":{"id":"/dgx-spark-notes-61","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"Consider using `limit` equal to `request` for memory to get OOMKilled instead of silent swapping."},"710":{"id":"/dgx-spark-notes-62","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Start with `kimi-test` workload."},"711":{"id":"/dgx-spark-notes-63","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Monitor for 30-60 minutes."},"712":{"id":"/dgx-spark-notes-64","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Gradually increase resources in a copy of the manifest."},"713":{"id":"/dgx-spark-notes-65","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Only then promote to the full `kimi` version."},"714":{"id":"/dgx-spark-notes-66","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Always stop workloads before maintenance/reboots."},"715":{"id":"/dgx-spark-notes-67","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#common-failure-modes","content":"Host freezes → insufficient memory limits or too many parallel requests."},"716":{"id":"/dgx-spark-notes-68","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#common-failure-modes","content":"NCCL timeouts → wrong interface names or firewall rules on high-speed links."},"717":{"id":"/dgx-spark-notes-69","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#common-failure-modes","content":"Pods stuck in ContainerCreating → GPU Operator not fully ready."},"718":{"id":"/dgx-spark-notes-70","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#common-failure-modes","content":"SSH unresponsive after 10+ minutes of load → reduce concurrency or model size."},"719":{"id":"/dgx-spark-notes-71","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#common-failure-modes","content":"Report exact symptoms and logs when asking for help."},"720":{"id":"/getting-started","page_id":"/getting-started","type":"page","content":"Getting Started","breadcrumbs":["Docs"],"tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started"},"721":{"id":"/getting-started-0","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started","content":"Gold path — operator client, topology file, cloud-init, Ansible, GPU Operator, doctor, kimi-test, dashboard URL, and reboot reminder on 1-5 DGX Spark nodes."},"722":{"id":"/getting-started-1","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#getting-started","content":"Getting Started"},"723":{"id":"/getting-started-2","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#prerequisites","content":"Prerequisites"},"724":{"id":"/getting-started-3","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#step-1--topology-file-inventory","content":"Step 1 — Topology file (inventory)"},"725":{"id":"/getting-started-4","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#step-2--cloud-init-physical-nodes","content":"Step 2 — cloud-init (physical nodes)"},"726":{"id":"/getting-started-5","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#step-3--bootstrap-k3s","content":"Step 3 — Bootstrap K3s"},"727":{"id":"/getting-started-6","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#step-4--gpu-operator","content":"Step 4 — GPU Operator"},"728":{"id":"/getting-started-7","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#step-5--verify-cluster--doctor","content":"Step 5 — Verify cluster + doctor"},"729":{"id":"/getting-started-8","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#step-6--first-safe-workload-kimi-test","content":"Step 6 — First safe workload (kimi-test)"},"730":{"id":"/getting-started-9","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#step-7--dashboard-url","content":"Step 7 — Dashboard URL"},"731":{"id":"/getting-started-10","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#step-8--reboot-reminder","content":"Step 8 — Reboot reminder"},"732":{"id":"/getting-started-11","page_id":"/getting-started","type":"heading","tags":["getting-started","bazel","k3s","ansible","safety"],"url":"/getting-started#next","content":"Next"},"733":{"id":"/getting-started-12","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"**What's on this page**"},"734":{"id":"/getting-started-13","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"Prerequisites (including the one-command operator-client setup) and out-of-band console"},"735":{"id":"/getting-started-14","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"The `lab.yaml` topology file for all five configurations (1 / 2 / 3 / 4 / 5 nodes)"},"736":{"id":"/getting-started-15","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"cloud-init, Ansible bootstrap, GPU Operator"},"737":{"id":"/getting-started-16","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"`doctor`, first verify, first safe workload (`kimi-test`)"},"738":{"id":"/getting-started-17","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"Dashboard URL and reboot reminder"},"739":{"id":"/getting-started-18","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"**What this enables**"},"740":{"id":"/getting-started-19","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"A repeatable first cluster with Resource Guard and no auto-start"},"741":{"id":"/getting-started-20","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"Verification after every phase before a heavy Job"},"742":{"id":"/getting-started-21","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#getting-started","content":"Topology choice: Choose topology. Profiles after this page: Profiles."},"743":{"id":"/getting-started-22","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"1–5 DGX Spark nodes, Ubuntu 22.04 or 24.04 (fabric per node count: Choose topology)"},"744":{"id":"/getting-started-23","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"`nvidia-smi` works on the node"},"745":{"id":"/getting-started-24","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"SSH key + sudo from your workstation (operator client)"},"746":{"id":"/getting-started-25","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"**Out-of-band console** (IPMI/iDRAC) — heavy Jobs can still wedge SSH if you skip Guard"},"747":{"id":"/getting-started-26","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"Operator client (the machine that runs Ansible and `manage.sh`): Ansible ≥ 2.14, kubectl, helm, **bazelisk**"},"748":{"id":"/getting-started-27","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"One command installs and verifies everything (Homebrew, no sudo):"},"749":{"id":"/getting-started-28","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"Same script, apt/dnf based:"},"750":{"id":"/getting-started-29","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"Install WSL2 + Ubuntu once (PowerShell), then the same script inside WSL:"},"751":{"id":"/getting-started-30","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"`status` subcommand reports what is already present; see Shell reference for the full contract."},"752":{"id":"/getting-started-31","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#prerequisites","content":"Never proceed without inventory ping and OOB access. Do not start kimi / Mode B/C until `start-test` succeeds."},"753":{"id":"/getting-started-32","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"The declarative topology `ansible/inventory/lab.yaml` is the single source of truth for\n**all five configurations** — node names/IPs, fabric, switch port map, and which Spark is\nthe orchestrator. Edit it, then render:"},"754":{"id":"/getting-started-33","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"Rendering produces the Ansible inventory (`ansible/inventory/hosts.ini`, gitignored),\nfabric group vars, per-node netplan, and per-node cloud-init user-data — all from the\ntopology file. Full model: Lab topology."},"755":{"id":"/getting-started-34","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"`fabric: none`, one node with `role: orchestrator`. No high-speed cabling, local NCCL only."},"756":{"id":"/getting-started-35","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"`fabric: pair`, two nodes with `hs_ifs` (one 200 Gb/s QSFP cable). `group_vars` `highspeed_*`\nis the **pair** NCCL reference."},"757":{"id":"/getting-started-36","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"`fabric: ring`, three nodes, QSFP triangle. **Not** “2-node plus spark2 with pair env” —\ncabling and Job env: LiteLLM rounded stack."},"758":{"id":"/getting-started-37","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"`fabric: switch` + `switch:` block (CRS804-4DDQ-hRM `port_map`, one entry per node; 5 nodes\nuse breakout lanes `sfpplus4a`/`sfpplus4b`). Do **not** paste 2-node `NCCL_SOCKET_IFNAME`\nonto switch hops without reading Interconnect & NCCL."},"759":{"id":"/getting-started-38","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"Any node may be the orchestrator — see Choose topology → Pick your orchestrator."},"760":{"id":"/getting-started-39","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"Verify:"},"761":{"id":"/getting-started-40","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"Expected: pong on every host. If not: SSH keys, management firewall, console `ip a`."},"762":{"id":"/getting-started-41","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-1--topology-file-inventory","content":"Still prefer a manual `hosts.ini`? `cp ansible/inventory/hosts.ini.example ansible/inventory/hosts.ini`\nand edit it — the classic path still works, it just skips the generated netplan / cloud-init."},"763":{"id":"/getting-started-42","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-2--cloud-init-physical-nodes","content":"Render early OS / highspeed user-data **before** or as the first part of bootstrap."},"764":{"id":"/getting-started-43","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-2--cloud-init-physical-nodes","content":"With a `lab.yaml` in place, user-data is generated per node at\n`ansible/files/generated/cloud-init/user-data-<node>.yaml` (all five fabrics). The static\nexamples `ansible/cloud-init/example-user-data-1node.yaml` / `example-user-data-2node.yaml`\nremain for ad-hoc labs. Feed rendered YAML via vendor BMC, or apply manually and reboot."},"765":{"id":"/getting-started-44","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-2--cloud-init-physical-nodes","content":"Extra-var `apply_now=true` writes user-data on the node and can reboot it. Inference must already be stopped. Default is render-only."},"766":{"id":"/getting-started-45","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-2--cloud-init-physical-nodes","content":"To import prep from bootstrap: `--extra-vars run_cloud_init_prep=true`."},"767":{"id":"/getting-started-46","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-3--bootstrap-k3s","content":"The playbook installs prereqs, highspeed netplan on 2+ nodes (from the generated per-node\nnetplan when present), K3s server on the **orchestrator** node (`role: orchestrator` in\n`lab.yaml`), agents, labels, kubeconfig."},"768":{"id":"/getting-started-47","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-3--bootstrap-k3s","content":"Verify:"},"769":{"id"