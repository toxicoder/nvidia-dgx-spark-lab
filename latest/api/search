-setup-56","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#differences-from-github","content":"Caching: mount persistent volumes for Bazel disk/repo caches; use `actions/cache` for npm/pip/Playwright when supported."},"841":{"id":"/gitea-ci-setup-57","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#differences-from-github","content":"Docs **publish** stays on GitHub Pages unless you add a separate Gitea deploy workflow."},"842":{"id":"/gitea-ci-setup-58","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#recommended-rollout-for-gitea-ultra-optimized","content":"Use the shipped `.gitea/workflows/ci.yml` (do not regress to a single job)."},"843":{"id":"/gitea-ci-setup-59","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#recommended-rollout-for-gitea-ultra-optimized","content":"Self-hosted runners (`gitea-act-runner` or compatible): mount persistent volume for `~/.cache/bazel-disk` and `~/.cache/bazel-repo` (and node\\_modules) for large cache hits across builds (key on `MODULE.bazel.lock` / `.bazelversion`)."},"844":{"id":"/gitea-ci-setup-60","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#recommended-rollout-for-gitea-ultra-optimized","content":"Use `actions/cache` for the same keys as GitHub where the runner supports it."},"845":{"id":"/gitea-ci-setup-61","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#recommended-rollout-for-gitea-ultra-optimized","content":"Runner labels: configure in Gitea admin (e.g. `self-hosted`, `linux`); use in `runs-on`."},"846":{"id":"/gitea-ci-setup-62","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#recommended-rollout-for-gitea-ultra-optimized","content":"Keep `.bazelrc` `--config=ci` for CI-oriented flags; raise resources on beefy self-hosted hardware as needed."},"847":{"id":"/gitea-ci-setup-63","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#recommended-rollout-for-gitea-ultra-optimized","content":"See also `.github/workflows/ci.yml` and `.bazelrc` for cache/parallel flags."},"848":{"id":"/gitea-ci-setup-64","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#caching--parallelism-tips-for-gitea","content":"Bazel: restore disk + repo cache in job steps (see `.bazelrc` and `setup-bazel`)."},"849":{"id":"/gitea-ci-setup-65","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#caching--parallelism-tips-for-gitea","content":"Non-hermetic: separate npm cache (`setup-node`), Python (`setup-python` cache)."},"850":{"id":"/gitea-ci-setup-66","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#caching--parallelism-tips-for-gitea","content":"Parallel: jobs run concurrently; self-hosted can run multiple in parallel (configure runner capacity)."},"851":{"id":"/gitea-ci-setup-67","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#caching--parallelism-tips-for-gitea","content":"For visuals/goldens: pre-install Playwright browsers in the runner image or cache `~/.cache/ms-playwright`."},"852":{"id":"/gitea-ci-setup-68","page_id":"/gitea-ci-setup","tags":["ci","gitea","forgejo","bazel","github-actions"],"type":"text","url":"/gitea-ci-setup#caching--parallelism-tips-for-gitea","content":"Docs **build** in CI: `bazelisk run //docs:docs --config=ci` then `bazelisk