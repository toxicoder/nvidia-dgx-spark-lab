tributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#what-the-container-provides","content":"Ansible"},"401":{"id":"/dev-environment-79","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#what-the-container-provides","content":"ansible, ansible-lint"},"402":{"id":"/dev-environment-80","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#what-the-container-provides","content":"Docker"},"403":{"id":"/dev-environment-81","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#what-the-container-provides","content":"**docker-outside-of-docker** (host engine) for hermetic dashboard images"},"404":{"id":"/dev-environment-82","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#what-the-container-provides","content":"Agent CLIs"},"405":{"id":"/dev-environment-83","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#what-the-container-provides","content":"Grok Build (`grok`, baked into the image), Hermes Agent (`hermes`) via post-create"},"406":{"id":"/dev-environment-84","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"Grok Build is **in the image** at `/usr/local/bin/grok` (pin + checksum in\n`tool-versions.env`). Post-create still runs `.devcontainer/install-agent-clis.sh`\n(skip with `DEVCONTAINER_SKIP_AGENT_CLIS=1`): it no-ops Grok when the pin\nmatches, and installs Hermes with `--skip-setup --non-interactive`. Installers\n**never** write API keys and **never** run setup wizards during create."},"407":{"id":"/dev-environment-85","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"The container can reach LLM providers on the **host** at\n`http://host.docker.internal:<port>/v1` (LiteLLM/vLLM on the workstation) and\ncloud APIs (`api.x.ai`, …) over ordinary egress. `devcontainer.json` adds\n`host.docker.internal` → `host-gateway` so this works on Docker Desktop **and**\nLinux Engine. Do not use `--network=host`."},"408":{"id":"/dev-environment-86","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"Default sandbox is `GROK_SANDBOX=lab`: workspace writes, kernel-deny of\n`/var/run/docker.sock` and typical secret globs (`**/.env`, `**/*.pem`). Humans\ncan still run `docker` for hermetic tests. Override with `GROK_SANDBOX=off` or\n`workspace` if you need the agent to talk to Docker. Copy\n`.devcontainer/host-llm.example.toml` into `~/.grok/config.toml` to register a\nhost model."},"409":{"id":"/dev-environment-87","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"Do not put `GROK_DEPLOYMENT_KEY`, OpenRouter/OpenAI/etc. keys, or Hermes\nauth files in the repo, in `devcontainer.json` env blocks, or in screenshots\nof create logs. Auth lives only on Docker volumes or your host home dir.\nSee SECURITY.md."},"410":{"id":"/dev-environment-88","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"Hermes **on the Spark host** (Docker gateway stacks) is documented separately in\nhermes-agent.md."},"411":{"id":"/dev-environment-89","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"Lifecycle (optimized):"},"412":{"id":"/dev-environment-90","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"**Image build** — independent fetch stages (Dockerfile). CI publishes\n`ghcr.io/toxicoder/nvidia-dgx-spark-lab/devcontainer` for layer cache\n(native `linux/amd64` + `linux/arm64`). After the first successful\npublish, set that GHCR package **public** so anonymous clones can use\n`build.cacheFrom`. Lab runtime images (`lab-dashboard`, `mcp-*`,\n`coder-workspace`) use the same GHCR namespace via\n`.github/workflows/publish-images.yml` — also set those packages public.\nBumping one CLI pin does not re-download the others. Node 22 and Python 3.11\nare baked (not Features). Workspace `npm ci` / Playwright stay in post-create."},"413":{"id":"/dev-environment-91","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"**updateContentCommand** — `post-create.sh --deps-only` (npm, docs, Playwright)"},"414":{"id":"/dev-environment-92","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"**postCreateCommand** — full post-create + doctor\\\nFull `//:test` is **not** a create gate (optional `DEVCONTAINER_SMOKE=1`)."},"415":{"id":"/dev-environment-93","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"Named volumes cache Bazel disk/repo, npm, pip, Playwright, and agent homes\n(`~/.grok`, `~/.hermes`) across rebuilds."},"416":{"id":"/dev-environment-94","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#agent-clis-and-secrets","content":"Feature pins for Dev Container Features live in\n`.devcontainer/devcontainer-lock.json`\n(**commit this file** — same role as other lockfiles)."},"417":{"id":"/dev-environment-95","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#day-to-day-commands","content":"VS Code tasks under **Terminal → Run Task** wrap the same targets."},"418":{"id":"/dev-environment-96","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#ide-settings-workspace","content":"`.vscode/settings.json`\nis tuned for this toolchain:"},"419":{"id":"/dev-environment-97","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#ide-settings-workspace","content":"Concern"},"420":{"id":"/dev-environment-98","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#ide-settings-workspace","content":"Extension / tool"},"421":{"id":"/dev-environment-99","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#ide-settings-workspace","content":"Notes"},"422":{"id":"/dev-environment-100","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#ide-settings-workspace","content":"**Types**"},"423":{"id":"/dev-environment-101","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#ide-settings-workspace","content":"Mypy (`mypy.ini`, `strict`)"},"424":{"id":"/dev-environment-