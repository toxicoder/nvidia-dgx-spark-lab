":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"**3**"},"3484":{"id":"/start/choose-topology-32","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"`ring`"},"3485":{"id":"/start/choose-topology-33","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"QSFP triangle (200 Gb/s per port per pair)"},"3486":{"id":"/start/choose-topology-34","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"Mode A daily fleet, or exclusive B/C"},"3487":{"id":"/start/choose-topology-35","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"**4**"},"3488":{"id":"/start/choose-topology-36","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"`switch`"},"3489":{"id":"/start/choose-topology-37","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"Mikrotik **CRS804-4DDQ-hRM**, four QSFP-DD ports"},"3490":{"id":"/start/choose-topology-38","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"e.g. Qwen 397B NVFP4 TP=4"},"3491":{"id":"/start/choose-topology-39","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"**5**"},"3492":{"id":"/start/choose-topology-40","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"`switch`"},"3493":{"id":"/start/choose-topology-41","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"CRS804: three full ports + one 400G port split into two 200G breakout lanes"},"3494":{"id":"/start/choose-topology-42","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"full-lab TP=4 + extra worker"},"3495":{"id":"/start/choose-topology-43","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#the-five-supported-configurations","content":"All five are declared in one file — `ansible/inventory/lab.yaml` — and everything else\n(Ansible inventory, netplan, cloud-init user-data, control-plane choice) is **generated from it**.\nSee Lab topology."},"3496":{"id":"/start/choose-topology-44","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#4--5-nodes--the-mikrotik-crs804-4ddq-hrm","content":"The switch is a managed 4-port 400G QSFP-DD device with a 10GbE management port:"},"3497":{"id":"/start/choose-topology-45","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#4--5-nodes--the-mikrotik-crs804-4ddq-hrm","content":"**4-node lab:** each Spark plugs into one of the four `sfpplus1`…`sfpplus4` ports at 400G."},"3498":{"id":"/start/choose-topology-46","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#4--5-nodes--the-mikrotik-crs804-4ddq-hrm","content":"**5-node lab:** three Sparks take three full ports; the fourth port uses a **breakout cable**\n(QSFP-DD to 2× QSFP) and carries two Sparks on lanes `sfpplus4a` and `sfpplus4b` at 200G each.\nBoth lanes must be declared together — the validator rejects a lone breakout lane."},"3499":{"id":"/start/choose-topology-47","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#4--5-nodes--the-mikrotik-crs804-4ddq-hrm","content":"Every link is its own /24 (192.168.110–114), MTU 9000. One RoCE device per node —\n**not** the dual-HCA pair env. Do not paste 2-node `NCCL_SOCKET_IFNAME` onto switch hops."},"3500":{"id":"/start/choose-topology-48","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#4--5-nodes--the-mikrotik-crs804-4ddq-hrm","content":"The switch's management IP (e.g. `10.0.0.2`) is declared in the `switch:` block; only a\n**read-only** API probe may use it. The switch password is read from the\n`LAB_SWITCH_PASSWORD` environment variable at runtime — never commit it."},"3501":{"id":"/start/choose-topology-49","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#4--5-nodes--the-mikrotik-crs804-4ddq-hrm","content":"Full per-fabric NCCL details: Interconnect & NCCL."},"3502":{"id":"/start/choose-topology-50","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#pick-your-orchestrator","content":"**Any** of the Sparks can run the K3s server. The declarative topology marks exactly one\nnode with `role: orchestrator`, and the generated inventory derives the groups from it:"},"3503":{"id":"/start/choose-topology-51","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#pick-your-orchestrator","content":"`k3s_server` — the orchestrator (control plane + worker)"},"3504":{"id":"/start/choose-topology-52","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#pick-your-orchestrator","content":"`k3s_agent` — every other node"},"3505":{"id":"/start/choose-topology-53","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#pick-your-orchestrator","content":"`k3s_cluster` — all nodes"},"3506":{"id":"/start/choose-topology-54","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#pick-your-orchestrator","content":"This is a lab, so re-assign the control plane freely — for example, when `spark0` is\noccupied with other experiments, run a 3-node ring on `spark1`, `spark2`, `spark3` with\n`spark1` as orchestrator, or a switch lab with `spark4` in charge. Cabling, netplan\nsubnets, and model placement do not care which node is the server; only the group\nmembership and the `k3s_control_plane` fact change."},"3507":{"id":"/start/choose-topology-55","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#pick-your-orchestrator","content":"Re-pointing `role: orchestrator` changes which node hosts the K3s server. On a running\ncluster that is a control-plane migration, not a config flip: drain the Jobs\n(`bazelisk run //:manage -- stop`), bootstrap the new server, then rejoin agents.\nOn a fresh lab it is just one line in `lab.yaml` before first bootstrap."},"3508":{"id":"/start/choose-topology-56","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"Nodes"},"3509":{"id":"/start/choose-topology-57","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"orchestrator"},"3510":{"id":"/start/choose-topology-58","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"others"},"3511":{"id":"/start/choose-topology-59","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"Fabric"},"3512":{"id":"/start/choose-topology-60","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"**1**"},"3513":{"id":"/start/choose-topology-61","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"control-plane + worker"},"3514":{"id":"/start/choose-topology-62","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator","content":"—"},"3515":{"id":"/start/choose-topology-63","page_id":"/start/choose-topology","tags":["topology","nccl","k3s","safety","nvidia","mikrotik"],"type":"text","url":"/start/choose-topology#roles-generated-from-role-orchestrator",