ags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#canonical-skeleton","content":"**Entry script** (utility or standalone tool):"},"2202":{"id":"/project-conventions-297","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#canonical-skeleton","content":"**Library** (`scripts/lib/*.sh`): `# ##` header, `# @function` on every function, no top-level `main \"$@\"`, minimal side effects beyond defaults / soft path setup."},"2203":{"id":"/project-conventions-298","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Rule"},"2204":{"id":"/project-conventions-299","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Value"},"2205":{"id":"/project-conventions-300","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Indent"},"2206":{"id":"/project-conventions-301","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"2 spaces, no tabs (except `<<-` heredocs)"},"2207":{"id":"/project-conventions-302","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"shfmt"},"2208":{"id":"/project-conventions-303","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"`shfmt -