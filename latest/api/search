"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#sequence","content":"Reboot **workers first** (spark1+), then spark0. 1-node: just spark0 after stop."},"4301":{"id":"/operate/patch-and-reboot-17","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#sequence","content":"Use IPMI/iDRAC/console if SSH is already degraded."},"4302":{"id":"/operate/patch-and-reboot-18","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#after-reboot","content":"Heavy profiles stay off until you start them. That is the safety property."},"4303":{"id":"/operate/patch-and-reboot-19","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#after-reboot","content":"Driver containers can take 5–15+ minutes. Watch `kubectl get pods -n gpu-operator -w` before starting Jobs."},"4304":{"id":"/operate/secrets","page_id":"/operate/secrets","type":"page","content":"Secrets","breadcrumbs":["Docs","Operate"],"tags":["secrets","security","dashboard","safety"],"url":"/operate/secrets"},"4305":{"id":"/operate/secrets-0","page_id":"/operate/secrets","tags":["secrets","security","dashboard","safety"],"type":"text","url":"/operate/secrets","content":"Example templates vs runtime secrets, dashboard vault sync to Kubernetes, and what must never be committed."},"4306":{"id":"/operate/secrets-1","page_id":"/operate/secrets","type":"heading","tags":["secrets","security","dashboard","safety"],"url":"/operate/secrets#secrets","content":"Secrets"},"4307":{"id":"/operate/secrets-2","page_id":"/operate/secrets","type":"heading","tags":["secrets","security","dashboard","safety"],"url":"/operate/secrets#templates-committed","content":"Templates (committed)"},"4308":{"id":"/operate/secrets-3","page_id":"/op