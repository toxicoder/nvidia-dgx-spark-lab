# Client templates and policy; the live secrets.env stays untracked and unowned.
filegroup(
    name = "config",
    srcs = [
        "config/clients/coder-workspace.mcp.json.example",
        "config/clients/cursor.mcp.json.example",
        "config/clients/vscode.mcp.json.example",
