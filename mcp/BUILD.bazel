# Package aggregate for //:everything: every tracked file in this package.
filegroup(
    name = "all",
    srcs = [
        "README.md",
        ":config",
        ":docker",
        ":k8s_manifests",
        ":python_sources",
        ":safety_data",
    ],
    visibility = ["//visibility:public"],
)
