ironment-137","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"Stale Bazel cache"},"464":{"id":"/dev-environment-138","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"`docker volume rm dgx-lab-bazel-disk dgx-lab-bazel-repo` then rebuild"},"465":{"id":"/dev-environment-139","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"Node version mismatch"},"466":{"id":"/dev-environment-140","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"Container and CI use **22**; set host Node 22 if not using the container"},"467":{"id":"/dev-environment-141","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"`mkdir … ~/.grok/…: Permission denied`"},"468":{"id":"/dev-environment-142","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"Named volume `dgx-lab-grok-home` is root-owned. In-container: `sudo chown -R \"$(id -u):$(id -g)\" ~/.grok ~/.hermes` then `bash .devcontainer/install-agent-clis.sh`. Or on host: `docker volume rm dgx-lab-grok-home dgx-lab-hermes-home` and rebuild."},"469":{"id":"/dev-environment-143","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"`grok: command not found`"},"470":{"id":"/dev-environment-144","page_id":"/dev-environment","tags":["devcontainer","c