ible","safety"],"type":"text","url":"/getting-started#step-4--gpu-operator","content":"Wait until GPU Operator pods are Running (5–15+ minutes first time):"},"797":{"id":"/getting-started-53","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-4--gpu-operator","content":"Expected: `nvidia.com/gpu` allocatable on each Spark."},"798":{"id":"/getting-started-54","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-5--verify-cluster--doctor","content":"Classic: `./scripts/manage.sh doctor`. Doctor is read-only. Fix anything it flags before a start."},"799":{"id":"/getting-started-55","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-6--first-safe-workload-kimi-test","content":"kimi-test requests **2 GPU / 32Gi / 8 CPU** (`backoffLimit: 2`). It is the cluster proving Job. Do not skip it."},"800":{"id":"/getting-started-56","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-6--first-safe-workload-kimi-test","content":"Stop:"},"801":{"id":"/getting-started-57","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-7--dashboard-url","content":"Optional Helm stack: `bazelisk run //ansible:install-dev-workspaces` or `bazelisk run //:manage -- start-monitoring`."},"802":{"id":"/getting-started-58","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"text","url":"/getting-started#step-7--dashboard-url","content":"Dashboard NodePort default: `http://{{SPARK0_IP}}:{{DASHBOARD_PORT}}` (32082). Journey: Dashboard."},"803":{"id":"/getting-started-59","page_id":"/getting-started","tags":["getting-started","bazel","k3s","ansible","safety"],"type":"te