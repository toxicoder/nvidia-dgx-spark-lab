v-environment-141","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"`mkdir … ~/.grok/…: Permission denied`"},"464":{"id":"/dev-environment-142","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"Named volume `dgx-lab-grok-home` is root-owned. In-container: `sudo chown -R \"$(id -u):$(id -g)\" ~/.grok ~/.hermes` then `bash .devcontainer/install-agent-clis.sh`. Or on host: `docker volume rm dgx-lab-grok-home dgx-lab-hermes-home` and rebuild."},"465":{"id":"/dev-environment-143","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"`grok: command not found`"},"466":{"id":"/dev-environment-144","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"Image pin missing — rebuild the container. Fallback: `bash .devcontainer/install-agent-clis.sh` then `grok login --device-auth`."},"467":{"id":"/dev-environment-145","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"Host LiteLLM unreachable"},"468":{"id":"/dev-environment-146","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troubleshooting","content":"Use `http://host.docker.internal:<port>/v1`, not `127.0.0.1` (that is the container). Docker Engine needs Docker 20.10+ (`host-gateway`)."},"469":{"id":"/dev-environment-147","page_id":"/dev-environment","tags":["devcontainer","contributing","bazel","onboarding","multi-arch"],"type":"text","url":"/dev-environment#troub