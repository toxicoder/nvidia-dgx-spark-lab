_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"DGX Spark Specific Notes"},"673":{"id":"/dgx-spark-notes-2","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#resource-management-is-critical","content":"Resource Management is Critical"},"674":{"id":"/dgx-spark-notes-3","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"Preventing Auto-Restart on Reboot"},"675":{"id":"/dgx-spark-notes-4","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#high-speed-interconnect","content":"High-Speed Interconnect"},"676":{"id":"/dgx-spark-notes-5","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"hostNetwork and hostIPC"},"677":{"id":"/dgx-spark-notes-6","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#ple-mmap-qwen38-flash-next","content":"PLE mmap (Qwen3.8-Flash-Next)"},"678":{"id":"/dgx-spark-notes-7","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"GPU Operator on K3s"},"679":{"id":"/dgx-spark-notes-8","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"Dual concurrent models (time-slicing)"},"680":{"id":"/dgx-spark-notes-9","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#blackwell-nvfp4-kernels","content":"Blackwell NVFP4 kernels"},"681":{"id":"/dgx-spark-notes-10","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#stability-tips","content":"Stability Tips"},"682":{"id":"/dgx-spark-notes-11","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#recommended-workflow","content":"Recommended Workflow"},"683":{"id":"/dgx-spark-notes-12","page_id":"/dgx-spark-notes","type":"heading","tags":["dgx","nvidia","nccl","safety","kubernetes"],"url":"/dgx-spark-notes#common-failure-modes","content":"Common Failure Modes"},"684":{"id":"/dgx-spark-notes-13","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"**What's on this page**"},"685":{"id":"/dgx-spark-notes-14","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Resource management rules critical for large models on DGX Spark hardware"},"686":{"id":"/dgx-spark-notes-15","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Reboot safety procedures and prevention of auto-restarts"},"687":{"id":"/dgx-spark-notes-16","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"High-speed interconnect per topology (pair, ring, CRS804 switch) and required NCCL settings"},"688":{"id":"/dgx-spark-notes-17","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"GPU Operator and K3s specifics for this platform"},"689":{"id":"/dgx-spark-notes-18","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Stability tips and common failure modes"},"690":{"id":"/dgx-spark-notes-19","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Recommended overall workflow"},"691":{"id":"/dgx-spark-notes-20","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"**What this enables**"},"692":{"id":"/dgx-spark-notes-21","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Keeping nodes responsive and SSH usable when running 70B+ and MoE models"},"693":{"id":"/dgx-spark-notes-22","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Applying the exact practices used by this lab for production inference"},"694":{"id":"/dgx-spark-notes-23","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dgx-spark-specific-notes","content":"Avoiding situations that make the host unusable or require long recovery"},"695":{"id":"/dgx-spark-notes-24","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Large models (70B+, MoE like Kimi-K2.6) can quickly exhaust host memory and make the node unresponsive over SSH."},"696":{"id":"/dgx-spark-notes-25","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"**Rules:**"},"697":{"id":"/dgx-spark-notes-26","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Always set `resources.requests` and `resources.limits` for both CPU and memory, not just GPU."},"698":{"id":"/dgx-spark-notes-27","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Use `restartPolicy: OnFailure` with `backoffLimit: 1` for heavy jobs."},"699":{"id":"/dgx-spark-notes-28","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Prefer Jobs over Deployments for one-shot or long-running inference servers that you control explicitly."},"700":{"id":"/dgx-spark-notes-29","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#resource-management-is-critical","content":"Never use `imagePullPolicy: Always` on multi-hundred-GB images."},"701":{"id":"/dgx-spark-notes-30","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"We do **not** use Deployments with high replica counts for heavy models."},"702":{"id":"/dgx-spark-notes-31","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"We do **not** use `restartPolicy: Always` for the main inference container."},"703":{"id":"/dgx-spark-notes-32","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"Workloads are started manually via `scripts/manage.sh`."},"704":{"id":"/dgx-spark-notes-33","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#preventing-auto-restart-on-reboot","content":"After reboot you must explicitly re-deploy."},"705":{"id":"/dgx-spark-notes-34","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"No inter-node NCCL. Local multi-GPU (if advertised) uses SHM/P2P, and the `highspeed`\ninventory group is ignored."},"706":{"id":"/dgx-spark-notes-35","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"**2-node pair (one 200 Gb/s QSFP cable):** existing Jobs and `group_vars` `highspeed_*` /\n`nccl_env` are **reference for a pair**. Typical env:"},"707":{"id":"/dgx-spark-notes-36","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"**3-node QSFP ring (200 Gb/s per pair, triangle mesh):** used by Mode B (`glm-5.3-flash`)\nand Mode C (`deepseek-v4.1-flash`). OOB/Gloo on 10GbE (often `enP7s7`); payload on all\nfour CX-7 RoCE devices; `NCCL_NET_PLUGIN=none`. Do **not** copy the 2-node pair vars onto\nthat ring. Confirm names with `ibdev2netdev`. See LiteLLM rounded stack."},"708":{"id":"/dgx-spark-notes-37","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"**4 / 5-node CRS804 switch:** each node sees **one** RoCE link — one full port per node\n(Spark CX-7 at 200 Gb/s) for 4 nodes, or three full ports plus one 400G QSFP-DD port split\ninto `sfpplus4a` / `sfpplus4b` (two 200G lanes) for 5. Every link is its own /24 (192.168.110–114, MTU 9000) from the\ngenerated per-node netplan. `NCCL_SOCKET_IFNAME` stays the management NIC; the payload\nrides the single RoCE HCA (`NCCL_IB_HCA` from live `ibdev2netdev` names per node). Heavy\nJobs use `hostNetwork: true` — do not assume the 2-node pair `NCCL_SOCKET_IFNAME` list is\ncomplete. Cabling and port map: Choose topology."},"709":{"id":"/dgx-spark-notes-38","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"If NCCL payload falls back to the management network, performance will be terrible."},"710":{"id":"/dgx-spark-notes-39","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#high-speed-interconnect","content":"Full fabric env: Interconnect & NCCL."},"711":{"id":"/dgx-spark-notes-40","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"**Omitted** (default false) on kimi / kimi-test and several 1-GPU vLLM Jobs — isolation; NCCL IFNAME still set in env."},"712":{"id":"/dgx-spark-notes-41","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"**`hostNetwork: true`** on Ray, GLM-5.2, Qwen 397B, Mode B/C — ranks need the fabric NICs."},"713":{"id":"/dgx-spark-notes-42","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"**`hostIPC: true`** on GLM RPC and Mode B/C ring Jobs — shared memory for TP."},"714":{"id":"/dgx-spark-notes-43","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#hostnetwork-and-hostipc","content":"Do not add hostNetwork to a Job “for luck”; follow the workload YAML."},"715":{"id":"/dgx-spark-notes-44","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#ple-mmap-qwen38-flash-next","content":"Mode A `qwen3.8-flash-next-nvfp4` requires PLE mmap (weights mapped, not fully resident). Prefix caching off. Start `max-model-len` 65536. See LiteLLM rounded stack."},"716":{"id":"/dgx-spark-notes-45","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#ple-mmap-qwen38-flash-next","content":"Verify interfaces on the nodes:"},"717":{"id":"/dgx-spark-notes-46","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"The NVIDIA GPU Operator works well on K3s but:"},"718":{"id":"/dgx-spark-notes-47","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"Use a recent version (v24.x+ recommended)."},"719":{"id":"/dgx-spark-notes-48","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"The driver container may take several minutes to load after first boot."},"720":{"id":"/dgx-spark-notes-49","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"On reboot, wait for `nvidia-smi` to succeed on both nodes before deploying heavy workloads."},"721":{"id":"/dgx-spark-notes-50","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#gpu-operator-on-k3s","content":"MIG is supported but requires explicit configuration in the ClusterPolicy."},"722":{"id":"/dgx-spark-notes-51","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"A single GB10 exposes **one** physical GPU. To schedule two inference Jobs concurrently (e.g. Qwen3.6 dual):"},"723":{"id":"/dgx-spark-notes-52","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"Apply `k8s/base/gpu-time-slicing` (`replicas: 2`)."},"724":{"id":"/dgx-spark-notes-53","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"Point the device plugin at that ConfigMap (`gpu_time_slicing_enabled: true` in Ansible, or helm upgrade)."},"725":{"id":"/dgx-spark-notes-54","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"Split memory with `--gpu-memory-utilization` (\\~0.38 each). Never run two processes at 0.9 util."},"726":{"id":"/dgx-spark-notes-55","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#dual-concurrent-models-time-slicing","content":"See qwen36-dual-stack.md."},"727":{"id":"/dgx-spark-notes-56","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#blackwell-nvfp4-kernels","content":"On DGX Spark, set `CUTE_DSL_ARCH=sm_121a`. For MoE NVFP4, use `--moe-backend flashinfer_b12x` or inference can be \\~2–2.5× slower (Marlin fallback)."},"728":{"id":"/dgx-spark-notes-57","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"Reserve headroom: leave at least 10-20% of host RAM and CPU free for the system + K3s."},"729":{"id":"/dgx-spark-notes-58","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"Use node affinity so that heavy inference prefers specific nodes if needed."},"730":{"id":"/dgx-spark-notes-59","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"Monitor with:"},"731":{"id":"/dgx-spark-notes-60","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"If SSH becomes laggy, the node is likely OOMing. Hard power cycle may be required in extreme cases."},"732":{"id":"/dgx-spark-notes-61","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#stability-tips","content":"Consider using `limit` equal to `request` for memory to get OOMKilled instead of silent swapping."},"733":{"id":"/dgx-spark-notes-62","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Start with `kimi-test` workload."},"734":{"id":"/dgx-spark-notes-63","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Monitor for 30-60 minutes."},"735":{"id":"/dgx-spark-notes-64","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Gradually increase resources in a copy of the manifest."},"736":{"id":"/dgx-spark-notes-65","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Only then promote to the full `kimi` version."},"737":{"id":"/dgx-spark-notes-66","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#recommended-workflow","content":"Always stop workloads before maintenance/reboots."},"738":{"id":"/dgx-spark-notes-67","page_id":"/dgx-spark-notes","tags":["dgx","nvidia","nccl","safety","kubernetes"],"type":"text","url":"/dgx-spark-notes#common-failure-modes","content":"Host freezes → insufficient memory limits or too many parallel requests."},"739