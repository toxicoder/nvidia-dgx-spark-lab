s","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#yaml-linting","content":"`.yamllint.yml`: 2-space indent, 120-char line length (warning), `document-start: disable`. Helm templates and Jinja (`.j2`) are excluded."},"2178":{"id":"/project-conventions-271","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#pre-commit-optional","content":"Hooks mirror Bazel lint tools: buildifier check, shfmt, shellcheck, prettier YAML, yamllint. See `.pre-commit-config.yaml`."},"2179":{"id":"/project-conventions-272","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#typescript-dashboard","content":"`strict: true`, `noImplicitAny`, `strictNullChecks`"},"2180":{"id":"/project-conventions-273","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#typescript-dashboard","content":"Path alias: `@/*` → dashboard root"},"2181":{"id":"/project-conventions-274","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#typescript-dashboard","content":"No explicit `any` (ESLint error)"},"2182":{"id":"/project-conventions-275","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#6-shell-scripts","content":"This section is the lab’s **adapted professional Bash style guide**. It synthesizes Google’s Shell Style Guide, ShellCheck, shfmt, and bats-core practice, tailored to Bazel, kcov, and the generated shell reference."},"2183":{"id":"/project-conventions-276","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Principle"},"2184":{"id":"/project-conventions-277","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Lab practice"},"2185":{"id":"/project-conventions-278","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Readability first**"},"2186":{"id":"/project-conventions-279","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Prefer clarity over clever one-liners"},"2187":{"id":"/project-conventions-280","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Small, focused functions**"},"2188":{"id":"/project-conventions-281","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"One responsibility; extract aggressively"},"2189":{"id":"/project-conventions-282","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Fail fast and loudly**"},"2190":{"id":"/project-conventions-283","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"`set -euo pipefail` on entry scripts; never continue in a broken state"},"2191":{"id":"/project-conventions-284","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Explicit over implicit**"},"2192":{"id":"/project-conventions-285","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Quote expansions; name locals; document public APIs"},"2193":{"id":"/project-conventions-286","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Testable by design**"},"2194":{"id":"/project-conventions-287","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Libs are sourceable; entry scripts use thin `main` + source guards"},"2195":{"id":"/project-conventions-288","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**ShellCheck is mandatory**"},"2196":{"id":"/project-conventions-289","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Warnings are defects until fixed or justified with a comment"},"2197":{"id":"/project-conventions-290","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Consistency**"},"2198":{"id":"/project-conventions-291","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"shfmt + this section beat personal taste"},"2199":{"id":"/project-conventions-292","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**When to use Bash:** orchestration, thin wrappers, cluster ops (`manage.sh`, utilities). Prefer Python (or another language) when a *new* piece needs complex data structures, non-trivial algorithms, or would be hard to unit-test in shell."},"2200":{"id":"/project-conventions-293","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Lab exception (scale):** modular domain libraries under `scripts/lib/` may exceed \\~100 lines because they are the operational surface. That is intentional—do not grow a single file with spaghetti; split domains instead. Do **not** rewrite `manage.sh` to Python without an explicit project decision."},"2201":{"id":"/project-conventions-294","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Every **executable** entry script starts with:"},"2202":{"id":"/project-conventions-295","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Prefer `#!/usr/bin/env bash` (portability) over Google’s `#!/bin/bash`."},"2203":{"id":"/project-conventions-296","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Optional: `set -Eeuo pipefail` when you install an `ERR` trap that must inherit into functions."},"2204":{"id":"/project-conventions-297","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Optional: `IFS=$'\\n\\t'` only when the script benefits; do not change IFS globally in libs without care."},"2205":{"id":"/project-conventions-298","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"**Libraries** (`scripts/lib/*.sh`) are *sourced* and intentionally omit `set -euo`—they inherit the caller’s options."},"2206":{"id":"/project-conventions-299","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Resolve paths with project helpers (kcov-safe), not only raw `BASH_SOURCE`:"},"2207":{"id":"/project-conventions-300","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Source `lib/common.sh` for `log`, `warn`, `err`, `die`, and shared helpers. Utilities may redefine logging with a utility-specific prefix (e.g. `[spark-clock]`), still on **stderr**."},"2208":{"id":"/project-conventions-301","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#canonical-skeleton","content":"**Entry script** (utility or standalone tool):"},"2209":{"id":"/project-conventions-302","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#canonical-skeleton","content":"**Library** (`scripts/lib/*.sh`): `# ##` header, `# @function` on every function, no top-level `main \"$@\"`, minimal side effects beyond defaults / soft path setup."},"2210":{"id":"/project-conventions-303","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Rule"},"2211":{"id":"/project-conventions-304","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Value"},"2212":{"id":"/project-conventions-305","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Indent"},"2213":{"id":"/project-conventions-306","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"2 spaces, no tabs (except `<<-` heredocs)"},"2214":{"id":"/project-conventions-307","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"shfmt"},"2215":{"id":"/project-conventions-308","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"`shfmt -w -s -i 2 -ci` (`//:fix`) / check: `//lints:shfmt`"},"2216":{"id":"/project-conventions-309","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Conditionals"},"2217":{"id":"/project-conventions-310","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"`[[ … ]]` preferred over `[` / `test`"},"2218":{"id":"/project-conventions-311","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"Command sub"},"2219":{"id":"/project-conventions-312","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#formatting-shfmt-is-source-of-truth","content":"`$(…)` not backticks"},"2220":{"id":"/project-conventions-313","page_id":"/project-conventions","tags":["conventions","contributing","safety","