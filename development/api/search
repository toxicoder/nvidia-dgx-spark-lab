el","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Small, focused functions**"},"2215":{"id":"/project-conventions-278","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"One responsibility; extract aggressively"},"2216":{"id":"/project-conventions-279","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Fail fast and loudly**"},"2217":{"id":"/project-conventions-280","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"`set -euo pipefail` on entry scripts; never continue in a broken state"},"2218":{"id":"/project-conventions-281","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Explicit over implicit**"},"2219":{"id":"/project-conventions-282","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Quote expansions; name locals; document public APIs"},"2220":{"id":"/project-conventions-283","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Testable by design**"},"2221":{"id":"/project-conventions-284","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Libs are sourceable; entry scripts use thin `main` + source guards"},"2222":{"id":"/project-conventions-285","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**ShellCheck is mandatory**"},"2223":{"id":"/project-conventions-286","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"Warnings are defects until fixed or justified with a comment"},"2224":{"id":"/project-conventions-287","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Consistency**"},"2225":{"id":"/project-conventions-288","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"shfmt + this section beat personal taste"},"2226":{"id":"/project-conventions-289","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**When to use Bash:** orchestration, thin wrappers, cluster ops (`manage.sh`, utilities). Prefer Python (or another language) when a *new* piece needs complex data structures, non-trivial algorithms, or would be hard to unit-test in shell."},"2227":{"id":"/project-conventions-290","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#philosophy","content":"**Lab exception (scale):** modular domain libraries under `scripts/lib/` may exceed \\~100 lines because they are the operational surface. That is intentional—do not grow a single file with spaghetti; split domains instead. Do **not** rewrite `manage.sh` to Python without an explicit project decision."},"2228":{"id":"/project-conventions-291","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Every **executable** entry script starts with:"},"2229":{"id":"/project-conventions-292","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Prefer `#!/usr/bin/env bash` (portability) over Google’s `#!/bin/bash`."},"2230":{"id":"/project-conventions-293","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Optional: `set -Eeuo pipefail` when you install an `ERR` trap that must inherit into functions."},"2231":{"id":"/project-conventions-294","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Optional: `IFS=$'\\n\\t'` only when the script benefits; do not change IFS globally in libs without care."},"2232":{"id":"/project-conventions-295","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"**Libraries** (`scripts/lib/*.sh`) are *sourced* and intentionally omit `set -euo`—they inherit the caller’s options."},"2233":{"id":"/project-conventions-296","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Resolve paths with project helpers (kcov-safe), not only raw `BASH_SOURCE`:"},"2234":{"id":"/project-conventions-297","page_id":"/project-conventions","tags":["conventions","contributing","safety","bazel","style"],"type":"text","url":"/project-conventions#baseline-entry-scripts","content":"Source `lib/common.sh` for `log`, `warn`, `err`, `die`, and shared helpers. Utilities may redefine logging with a utility-specific prefix (e.g. `[spark-clock]`), still on **stderr**."},"2235":{"id":"/project-conventions-298","page_id":"/pr