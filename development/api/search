sting","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#using-bazel-for-daily-work","content":"Bazel is the established entry point for every build, test, lint, docs, and operations command. The\nMakefile stays as a compatibility shim for people and jobs without `bazelisk`, and it delegates to\nBazel whenever `bazelisk` is on `PATH`. The few places that still call a script directly (the\ndevcontainer's `postStartCommand` bootstrap, the CI dependency warm-up, `scripts/ci_check_only.sh`)\nare listed with their reasons in project-conventions.md."},"159":{"id":"/BUILDING_WITH_BAZEL-157","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#development-container","content":"First-class multi-arch contributor environment (`.devcontainer/`): **linux/amd64 + linux/arm64**."},"160":{"id":"/BUILDING_WITH_BAZEL-158","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#development-container","content":"Host"},"161":{"id":"/BUILDING_WITH_BAZEL-159","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#development-container","content":"Notes"},"162":{"id":"/BUILDING_WITH_BAZEL-160","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#development-container","content":"macOS Apple Silicon / Intel"},"163":{"id":"/BUILDING_WITH_BAZEL-161","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#development-container","content":"Docker Desktop"},"164":{"id":"/BUILDING_WITH_BAZEL-162","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#development-container","content":"Windows x86\\_64"},"165":{