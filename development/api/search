esting","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#building-and-testing-with-bazel","content":"Confidence that changes don't break the automation or docs pipeline"},"32":{"id":"/BUILDING_WITH_BAZEL-30","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#building-and-testing-with-bazel","content":"The traditional Makefile and direct `ansible-playbook` / `bazelisk run //:manage --` invocations remain available for compatibility and for people who have not installed bazelisk."},"33":{"id":"/BUILDING_WITH_BAZEL-31","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#prerequisites","content":"Bazelisk (strongly recommended)"},"34":{"id":"/BUILDING_WITH_BAZEL-32","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#prerequisites","content":"Or a recent Bazel 8.x+"},"35":{"id":"/BUILDING_WITH_BAZEL-33","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#prerequisites","content":"The `.bazelversion` pins the version."},"36":{"id":"/BUILDING_WITH_BAZEL-34","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#documentation-generation--efficiency","content":"Documentation for commands, helpers, and internal APIs is generated from source so it **never goes stale**."},"37":{"id":"/BUILDING_WITH_BAZEL-35","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"`docs/generate_shell_docs.py` is a tiny stdlib-only extractor that turns specially formatted comments in the shell scripts into a beautiful, human-readable reference page."},"38":{"id":"/BUILDING_WITH_BAZEL-36","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"Markers (documented extensively in getting-started.md and CONTRIBUTING.md):"},"39":{"id":"/BUILDING_WITH_BAZEL-37","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"`# ## Title` + rich body"},"40":{"id":"/BUILDING_WITH_BAZEL-38","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"`# @command name` + description + Usage + Safety + Examples (with `{{PLACEHOLDER}}`)"},"41":{"id":"/BUILDING_WITH_BAZEL-39","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"`# ### Subsection`"},"42":{"id":"/BUILDING_WITH_BAZEL-40","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"The generator now produces:"},"43":{"id":"/BUILDING_WITH_BAZEL-41","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"Proper fenced code blocks using the `bash` language"},"44":{"id":"/BUILDING_WITH_BAZEL-42","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"`!!! warning` / `!!! note` admonitions"},"45":{"id":"/BUILDING_WITH_BAZEL-43","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"Clean separation between intentional docs and implementation comments"},"46":{"id":"/BUILDING_WITH_BAZEL-44","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"Source attribution"},"47":{"id":"/BUILDING_WITH_BAZEL-45","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"It is deliberately strict about what it includes so the output is pleasant to read."},"48":{"id":"/BUILDING_WITH_BAZEL-46","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"Run it with:"},"49":{"id":"/BUILDING_WITH_BAZEL-47","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"The output is at `docs/generated/shell/reference.md` and appears in the site under **Reference > Code-Generated Reference**."},"50":{"id":"/BUILDING_WITH_BAZEL-48","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"Because `//docs:docs` and `//docs:serve` list the script sources as data dependencies (via `//scripts:doc_sources`), Bazel only re-runs generation when comments actually change."},"51":{"id":"/BUILDING_WITH_BAZEL-49","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#shell-commands--helpers-the-main-auto-generated-reference","content":"The generated trees are ordinary content to the site: `//docs-site:*` targets depend on\n`//docs:content`, which globs `docs/generated/**` alongside the hand-written pages, so a\nregenerated reference invalidates the build and the sidebar picks the new headings up with no\nextra wiring."},"52":{"id":"/BUILDING_WITH_BAZEL-50","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#dashboard-api-reference","content":"Produced by TypeDoc from JSDoc in the Next.js/TypeScript code:"},"53":{"id":"/BUILDING_WITH_BAZEL-51","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#dashboard-api-reference","content":"See `dashboard/typedoc.json` and the package.json `docs:generate` script."},"54":{"id":"/BUILDING_WITH_BAZEL-52","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"Docs checks are split by what they need, so a one-line edit does not pay for a browser:"},"55":{"id":"/BUILDING_WITH_BAZEL-53","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"`//docs:test_docs_site_render` — source contract of every navigable page: frontmatter,\nthe two overview sections, fenced languages, Mermaid label quoting, prose/list separation,\nand the navigation covering the pages the old site published (no browser, in `//:test-fast`)"},"56":{"id":"/BUILDING_WITH_BAZEL-54","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"`//docs:render-check` — the same file run against the **exported** HTML: search index and\ntags, Mermaid/callout elements, the edit-on-GitHub link, and the cluster-variables panel\nkeeping its tokens editable. A `run` target, because it reads `docs-site/out/`"},"57":{"id":"/BUILDING_WITH_BAZEL-55","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"`//docs-site:unit` — Vitest over the site's `lib/`, `components/` and `app/` under the 100%\ncoverage thresholds in `docs-site/vitest.config.ts`"},"58":{"id":"/BUILDING_WITH_BAZEL-56","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"`//docs-site:typecheck` — `next typegen` + `tsc --noEmit`"},"59":{"id":"/BUILDING_WITH_BAZEL-57","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"`//docs-site:visual-linux` — screenshot baselines rendered inside the pinned Playwright\ncontainer, i.e. the same renderer the `docs-and-render` job compares against (needs Docker)"},"60":{"id":"/BUILDING_WITH_BAZEL-58","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"`//docs-site:visual` — the same suite on the host browser; a debugging aid for one\nenvironment, not how baselines are produced (`manual`-tagged: a browser cannot launch inside\na sandboxed test action)"},"61":{"id":"/BUILDING_WITH_BAZEL-59","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"`//docs-site:visual_tooling_test` — guards that the container image stays pinned to the\nPlaywright release the suite imports, that it matches the CI platform, and that the spec never\ninvents a baseline under CI"},"62":{"id":"/BUILDING_WITH_BAZEL-60","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"The visual suite serves the export itself (`playwright.config.mjs` `webServer` runs\n`scripts/serve_static.mjs`), so nothing has to be started by hand. It captures the ten pages\nwhose rendering carries risk — index, getting-started, architecture, models-catalog,\ntroubleshooting, reboot-safety, dgx-spark-notes, monitoring-observability, dev-workspaces,\ngitea-ci-setup — at both desktop and mobile widths, waits for hydration plus the client-side\nMermaid SVGs, and drives every animation and transition to its end state before capturing so\nbaselines are reproducible."},"63":{"id":"/BUILDING_WITH_BAZEL-61","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"Any change to Markdown, MDX, components, CSS, or generated content that moves pixels fails\nthe suite with a diff, rather than being noticed by a reader."},"64":{"id":"/BUILDING_WITH_BAZEL-62","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"**Baselines come from the CI image, not from a laptop.** Font metrics differ per platform, so\na macOS golden will not match Linux CI Chromium and fails `docs-and-render`. The launcher\nbuilds the export inside the container as well, because the Next production bundle carries\nplatform-specific native code, and the container refuses to render unless it reports the CI\narchitecture. Refresh and review:"},"65":{"id":"/BUILDING_WITH_BAZEL-63","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"Under CI a page with no baseline is a hard failure rather than a silent self-capture, so no\nunreviewed screenshot can be committed. Pixel changes are reviewed like code."},"66":{"id":"/BUILDING_WITH_BAZEL-64","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"A machine with no Docker daemon can still land a reviewed refresh. The `docs-and-render` job\nuploads a `docs-visual-actuals` artifact holding the container's `*-actual.png` for every page\nthat failed, captured by the same renderer that compares against it:"},"67":{"id":"/BUILDING_WITH_BAZEL-65","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"Open the images before committing them. `bazelisk run //docs-site:visual-linux -- --update`\nstays the way to capture a page the suite has never baselined."},"68":{"id":"/BUILDING_WITH_BAZEL-66","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#visual-regression-tests-for-the-rendered-docs-site-goldens--approval","content":"`//:test-fast` deliberately excludes the browser work: it stays runnable without a Chromium\ndownload, which is what makes it the cheap default in `bazel-core`."},"69":{"id":"/BUILDING_WITH_BAZEL-67","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"The MkDocs site published two aliases with **mike**; Fumadocs has no mike equivalent, so the\nsame URLs are produced by building the static export twice with different `basePath` values:"},"70":{"id":"/BUILDING_WITH_BAZEL-68","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"Alias"},"71":{"id":"/BUILDING_WITH_BAZEL-69","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"Branch"},"72":{"id":"/BUILDING_WITH_BAZEL-70","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"Build target"},"73":{"id":"/BUILDING_WITH_BAZEL-71","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"URL"},"74":{"id":"/BUILDING_WITH_BAZEL-72","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`latest` (default)"},"75":{"id":"/BUILDING_WITH_BAZEL-73","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`main`"},"76":{"id":"/BUILDING_WITH_BAZEL-74","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`//docs-site:build-latest` (`DOCS_ALIAS=latest`)"},"77":{"id":"/BUILDING_WITH_BAZEL-75","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`…/nvidia-dgx-spark-lab/latest/`"},"78":{"id":"/BUILDING_WITH_BAZEL-76","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`development`"},"79":{"id":"/BUILDING_WITH_BAZEL-77","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`development`"},"80":{"id":"/BUILDING_WITH_BAZEL-78","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`//docs-site:build-development` (`DOCS_ALIAS=development`)"},"81":{"id":"/BUILDING_WITH_BAZEL-79","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`…/nvidia-dgx-spark-lab/development/`"},"82":{"id":"/BUILDING_WITH_BAZEL-80","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`DOCS_ALIAS` makes Next bake `basePath=/nvidia-dgx-spark-lab/<alias>` into every asset URL.\nA host-root prefix such as `/latest` would request `https://<user>.github.io/latest/_next/...`\nand 404 on GitHub project Pages."},"83":{"id":"/BUILDING_WITH_BAZEL-81","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"Both aliases come from the same commit, so they never disagree about content, and each is a\ncomplete export (assets and the search index are baked with their prefix, so they are not\nshared between prefixes). A root `index.html` forwards bare URLs to `/latest/`, which keeps\nevery previously published and bookmarked address working — no redirect service required."},"84":{"id":"/BUILDING_WITH_BAZEL-82","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"Workflow: `.github/workflows/deploy-docs.yml` runs **only on push** to `main`/`master`/`development`\n(docs paths) or `workflow_dispatch` — not on `pull_request`. Merging a PR into those branches is\nwhat publishes; PR-time docs validation is the `docs-and-render` CI job, not this workflow. The\njob assembles `_site/{latest,development}`, writes a root `.nojekyll` (GitHub Pages still uses\nthe legacy `gh-pages` branch, which otherwise runs Jekyll and drops Next's `_next/` tree), and\nfast-forwards that branch. Never force-push `gh-pages`."},"85":{"id":"/BUILDING_WITH_BAZEL-83","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`DGX_DOCS_VERSION` is the branch-aware knob the MkDocs hooks used, now read by the app:"},"86":{"id":"/BUILDING_WITH_BAZEL-84","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"`development` renders the non-production banner"},"87":{"id":"/BUILDING_WITH_BAZEL-85","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"“Edit on GitHub” points at `edit/development/docs/…` (otherwise `edit/main/docs/…`)"},"88":{"id":"/BUILDING_WITH_BAZEL-86","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"in-repo GitHub source links resolve against the same long-lived ref"},"89":{"id":"/BUILDING_WITH_BAZEL-87","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"Optional local override: `DGX_DOCS_GIT_REF=development` (or `main`). Feature-branch names are not\nauto-mapped, since an edit link into an unpublished branch would 404."},"90":{"id":"/BUILDING_WITH_BAZEL-88","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#multi-version-public-docs-latest--development","content":"Local dev (`bazelisk run //docs:serve`) builds neither alias: it serves at the root with hot\nreload, which is the right thing for authoring."},"91":{"id":"/BUILDING_WITH_BAZEL-89","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#why-this-design","content":"Comments that describe behavior live right next to the code that implements it."},"92":{"id":"/BUILDING_WITH_BAZEL-90","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#why-this-design","content":"One change in a script comment → reference, examples on the site, and live panel examples all update together."},"93":{"id":"/BUILDING_WITH_BAZEL-91","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#why-this-design","content":"Over-documenting in the scripts is explicitly encouraged (see user request and AGENTS guidance)."},"94":{"id":"/BUILDING_WITH_BAZEL-92","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#why-this-design","content":"See the Mermaid pipeline at the top of this section and CONTRIBUTING.md for markers, workflow, and contribution instructions."},"95":{"id":"/BUILDING_WITH_BAZEL-93","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#why-this-design","content":"The previous short paragraph has been replaced by this more complete description."},"96":{"id":"/BUILDING_WITH_BAZEL-94","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#validation-discipline-used-during-development","content":"After any change, use the unified orchestrator:"},"97":{"id":"/BUILDING_WITH_BAZEL-95","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#validation-discipline-used-during-development","content":"`//:validate` always runs core checks (`build //... --nobuild`, `//:test-fast`, `//:lint`, key builds). When docs-relevant paths change (`docs/**`, `docs-site/**`, shell doc sources under `//:manage` / `lib` / `utilities`) it also runs `//docs:test_docs_site_render` + `//docs-site:unit` + `//docs-site:typecheck` + `//docs-site:visual_tooling_test` (fast, no browser). Use `--all` to add the static export, the export-backed `//docs:render-check`, the screenshot comparison in the CI container (`//docs-site:visual-linux`, needs Docker), and `//dashboard:hermetic-test` (Docker + Playwright). `--update-goldens` captures fresh baselines in that same container instead of comparing. Default dashboard slice uses `//dashboard:fast-test` (host Vitest + lint + typecheck)."},"98":{"id":"/BUILDING_WITH_BAZEL-96","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#validation-discipline-used-during-development","content":"`//:fix` uses only well-trusted software (buildifier, shfmt, ruff, prettier) and is the recommended one-command way to programmatically clean the tree."},"99":{"id":"/BUILDING_WITH_BAZEL-97","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#validation-discipline-used-during-development","content":"CI uses path-filtered parallel jobs (optimized for wall time):"},"100":{"id":"/BUILDING_WITH_BAZEL-98","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#validation-discipline-used-during-development","content":"Job"},"101":{"id":"/BUILDING_WITH_BAZEL-99","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#validation-discipline-used-during-development","content":"When"},"102":{"id":"/BUILDING_WITH_BAZEL-100","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#validation-discipline-used-during-development","content":"What"},"103":{"id":"/BUILDING_WITH_BAZEL-101","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#validation-discipline-used-during-development","content":"**bazel-core**"},"104":{"id":"/BUILDING_WITH_BAZEL-102","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#validation-discipline-