n","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#published-lab-images-ghcr","content":"Cluster manifests stay on `:local` with `imagePullPolicy: IfNotPresent`. After the first successful publish, set the GHCR packages **public** so nodes can pull without `imagePullSecrets`. Rebuild a single image with `workflow_dispatch` (`image=<id>` or `all`)."},"138":{"id":"/BUILDING_WITH_BAZEL-136","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#security-notes","content":"Never commit real `ansible/inventory/hosts.ini` (it is gitignored)."},"139":{"id":"/BUILDING_WITH_BAZEL-137","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#security-notes","content":"Kubeconfig, tokens, and SSH material are excluded."},"140":{"id":"/BUILDING_WITH_BAZEL-138","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#security-notes","content":"The BATS tests mock external commands (including kubectl) so they never touch real clusters or credentials."},"141":{"id":"/BUILDING_WITH_BAZEL-139","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#security-notes","content":"Bazel runfiles + explicit data dependencies make exactly what is needed visible (no accidental leakage of host files)."},"142":{"id":"/BUILDING_WITH_BAZEL-140","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#security-notes","content":"`MODULE.bazel.lock` is committed (standard for reproducible Bzlmod) and contains only public registry metadata."},"143":{"id":"/BUILDING_WITH_BAZEL-141","page_id":"/BUILDING_WITH_BAZEL","tags":["bazel","testing","documentation","devcontainer"],"type":"text","url":"/BUILDING_WITH_BAZEL#sec