operate/overlays-81","page_id":"/operate/overlays","tags":["kustomize","overlays","kubernetes","safety"],"type":"text","url":"/operate/overlays#theory","content":"Rounded overlay (Mode A) is mutually exclusive with GLM-5.3-Flash and DeepSeek-V4.1-Flash starts,\nand with the DeepSeek-V4-Flash DSpark, GLM-5.3-Flash EXL3 TensorFold, Qwen3.8-27B EXL3,\nQwen3.8-27B TensorFold, and Qwen3.8-Flash-Next TensorFold lanes. Those lanes also refuse each\nother. The CLI refuses collisions."},"4281":{"id":"/operate/patch-and-reboot","page_id":"/operate/patch-and-reboot","type":"page","content":"Patch and reboot","breadcrumbs":["Docs","Operate"],"tags":["reboot","safety","operate","kubernetes"],"url":"/operate/patch-and-reboot"},"4282":{"id":"/operate/patch-and-reboot-0","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot","content":"OS patch, GPU Operator, drain, stop inference first, and reboot order for DGX Spark nodes."},"4283":{"id":"/operate/patch-and-reboot-1","page_id":"/operate/patch-and-reboot","type":"heading","tags":["reboot","safety","operate","kubernetes"],"url":"/operate/patch-and-reboot#patch-and-reboot","content":"Patch and reboot"},"4284":{"id":"/operate/patch-and-reboot-2","page_id":"/operate/patch-and-reboot","type":"heading","tags":["reboot","safety","operate","kubernetes"],"url":"/operate/patch-and-reboot#sequence","content":"Sequence"},"4285":{"id":"/operate/patch-and-reboot-3","page_id":"/operate/patch-and-reboot","type":"heading","tags":["reboot","safety","operate","kubernetes"],"url":"/operate/patch-and-reboot#after-reboot","content":"After reboot"},"4286":{"id":"/operate/patch-and-reboot-4","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"Stop inference before any host reboot"},"4287":{"id":"/operate/patch-and-reboot-5","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"Drain vs `manage.sh stop`"},"4288":{"id":"/operate/patch-and-reboot-6","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"GPU Operator / driver updates"},"4289":{"id":"/operate/patch-and-reboot-7","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"Node order and post-reboot verify"},"4290":{"id":"/operate/patch-and-reboot-8","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"Patching Ubuntu or the GPU Operator without pinning unified memory on the way down"},"4291":{"id":"/operate/patch-and-reboot-9","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"Coming back with an empty `ai-inference` namespace (by design)"},"4292":{"id":"/operate/patch-and-reboot-10","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"Full reboot narrative: Reboot safety."},"4293":{"id":"/operate/patch-and-reboot-11","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"Large Jobs can exhaust host memory and make SSH unusable. `restartPolicy: OnFailure` will **not** bring them back — you must start again — but a reboot *during* a 90Gi+ Job can still hang the node."},"4294":{"id":"/operate/patch-and-reboot-12","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#sequence","content":"From the workstation:"},"4295":{"id":"/operate/patch-and-reboot-13","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#sequence","content":"Confirm `kubectl get pods -n {{NAMESPACE}}` is empty (or Completed and deleted)."},"4296":{"id":"/operate/patch-and-reboot-14","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#sequence","content":"Optional: `kubectl drain <node> --ignore-daemonsets --delete-emptydir-data` for worker OS patches. Drain does **not** replace step 1 for Jobs that already occupy unified memory."},"4297":{"id":"/operate/patch-and-reboot-15","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#sequence","content":"Patch OS packages on the node (vendor docs). For GPU Operator, re-run `bazelisk run //ansible:gpu-operator -- -i inventory/hosts.ini` **after** nodes are up, not during a hung driver compile with inference running."},"4298":{"id":"/operate/patch-and-reboot-16","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#sequence","content":"Reboot **workers first** (spark1+), then spark0. 1-node: just spark0 after stop."},"4299":{"id":"/operate/patch-and-reboot-17","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#sequence","content":"Use IPMI/iDRAC/console if SSH is already degraded."},"4300":{"id":"/operate/patch-and-reboot-18","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#after-reboot","content":"Heavy profiles stay off until you start them. That is the safety property."},"4301":{"id":"/operate/patch-and-reboot-19","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#after-reboot","content":"Driver containers can take 5–15+ minutes. Watch `kubectl get pods -n gpu-operator -w` before starting Jobs."},"4302":{"id":"/operate/secrets","page_id":"/operate/secrets","type":"page","content":"Secrets","breadcrumbs":["Docs","Operate"],"tags":["secrets","security","dashboard","safety"],"url":"/operate/secrets"},"4303":{"id":"/operate/secrets-0","page_id":"/operate/secrets","tags":["secrets","security","dashboard","safety"],"type":"text","url":"/operate/secrets","content":"Example templates vs runtime secrets, dashboard vault sync to Kubernetes, and what must never be committed."},"4304":{"id":"/operate/secrets-1","page_id":"/operate/secrets","type":"heading","tags":["secrets","security","dashboard","safety"],"url":"/operate/secrets#secrets","content":"Secrets"},"4305":{"id":"/operate/secrets-2","page_id":"/operate/secrets","type":"heading","tags":["secrets","security","dashboard","safety"],"url":"/operate/secrets#templates-committed","content":"Templates (committed)"},"4306":{"id":"/operate/secrets-3","page_id":"/operate/secrets","type":"heading","tags":["secrets","security","dashboard","safety"],"url":"/operate/secrets#dashboard-vault","content":"Dashboard vault"},"4307":{"id":"/operate/secrets-4","page_id":"/operate/secrets","type":"heading","tags":["secrets","security","dashboard","safety"],"url":"/operate/secrets#other-runtime-secrets","content":"Other runtime secrets"},"4308":{"id":"/operate/secrets-5","page_id":"/operate/secrets","type":"heading","tags":["secrets","security","dashboard","safety"],"url":"/operate/secrets#verify","content":"Verify"},"4309":{"id":"/operate/secrets-6","page_id":"/operate/secrets","tags":["secrets","security","dashboard","safety"],"type":"text","url":"/operate/secrets#secrets","content":"Committed `*.example` files versus live Secrets"},"4310":{"id":"/ope