fety","contributing"],"url":"/strong-types#the-rule","content":"The rule"},"3170":{"id":"/strong-types-3","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#per-language","content":"Per language"},"3171":{"id":"/strong-types-4","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#typescript","content":"TypeScript"},"3172":{"id":"/strong-types-5","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#closed-sets-live-in-one-place","content":"Closed sets live in one place"},"3173":{"id":"/strong-types-6","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#validate-at-the-boundary-not-at-the-call-site","content":"Validate at the boundary, not at the call site"},"3174":{"id":"/strong-types-7","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#indexing-is-an-assertion-not-a-guess","content":"Indexing is an assertion, not a guess"},"3175":{"id":"/strong-types-8","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#python","content":"Python"},"3176":{"id":"/strong-types-9","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#shared-vocabulary","content":"Shared vocabulary"},"3177":{"id":"/strong-types-10","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#two-small-rules-that-matter","content":"Two small rules that matter"},"3178":{"id":"/strong-types-11","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#shell","content":"Shell"},"3179":{"id":"/strong-types-12","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#data-files","content":"Data files"},"3180":{"id":"/strong-types-13","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#when-a-broad-type-really-is-right","content":"When a broad type really is right"},"3181":{"id":"/strong-types-14","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#adding-a-type-adding-a-gate","content":"Adding a type, adding a gate"},"3182":{"id":"/strong-types-15","page_id":"/strong-types","type":"heading","tags":["conventions","typescript","python","shell","safety","contributing"],"url":"/strong-types#see-also","content":"See also"},"3183":{"id":"/strong-types-16","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#strong-types","content":"The rule this repository holds itself to, and why it is a safety rule here"},"3184":{"id":"/strong-types-17","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#strong-types","content":"The instrument and the enforcing gate for each language: TypeScript, Python, Shell, BATS, data files"},"3185":{"id":"/strong-types-18","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#strong-types","content":"Patterns for the places a broad type looks unavoidable"},"3186":{"id":"/strong-types-19","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#strong-types","content":"How to add a type, and how to add a gate"},"3187":{"id":"/strong-types-20","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#strong-types","content":"A renamed or missing key in a utility's JSON fails at the edge, where it is named, instead of rendering a wrong capacity verdict later"},"3188":{"id":"/strong-types-21","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#strong-types","content":"`//:validate` catches a shape error, so a reviewer does not have to hold every payload in their head"},"3189":{"id":"/strong-types-22","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#strong-types","content":"New code arrives with its shape already declared, which makes the next change smaller"},"3190":{"id":"/strong-types-23","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#the-rule","content":"Declare the shape. A name like `Any`, `object`, `dict`, or `Record<string, unknown>` says the author stopped looking. Where a shape genuinely is unknown, say so in a comment next to the narrowest type that still compiles, and record why at the gate's config rather than in an inline suppression."},"3191":{"id":"/strong-types-24","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#the-rule","content":"This is a safety rule in this repository specifically because the Resource Guard reads a JSON verdict produced by a shell utility, and that verdict gates heavy GPU workload starts. Before the boundary parser existed, the dashboard wrote `JSON.parse(stdout) as CapacityCheck`; a renamed key in `scripts/utilities/cluster-resources.sh` would have produced `{ ok: undefined }`, and an unblocked start is the kind of failure nothing logs."},"3192":{"id":"/strong-types-25","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"Language"},"3193":{"id":"/strong-types-26","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"Instrument"},"3194":{"id":"/strong-types-27","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"Gate"},"3195":{"id":"/strong-types-28","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"TypeScript"},"3196":{"id":"/strong-types-29","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"`strict` plus the flags below, type-aware ESLint, `as const` source-of-truth arrays, zod at every boundary"},"3197":{"id":"/strong-types-30","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"`//dashboard:typecheck`, `//dashboard:lint`, `//docs-site:typecheck`, `//docs-site:lint`"},"3198":{"id":"/strong-types-31","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"Python"},"3199":{"id":"/strong-types-32","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"Full annotations, `TypedDict`, `StrEnum`, `Final`, type aliases, `NoReturn`"},"3200":{"id":"/strong-types-33","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"`//lints:mypy` (`mypy.ini`, `disallow_any_explicit`)"},"3201":{"id":"/strong-types-34","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"Shell"},"3202":{"id":"/strong-types-35","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"`scripts/lib/types.sh` value-kind contracts (`is_*` / `require_*`)"},"3203":{"id":"/strong-types-36","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"`//tests:bats_value_types_test`"},"3204":{"id":"/strong-types-37","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"BATS"},"3205":{"id":"/strong-types-38","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"Contract tests that check each predicate both ways"},"3206":{"id":"/strong-types-39","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"`//tests:bats`"},"3207":{"id":"/strong-types-40","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"Data files"},"3208":{"id":"/strong-types-41","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"`tests/config_twin_check.py` compares each `.yaml`/`.json` twin"},"3209":{"id":"/strong-types-42","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#per-language","content":"`//tests:safety_invariants`"},"3210":{"id":"/strong-types-43","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"Both Node apps (`dashboard/`, `docs-site/`) set `strict` and add the flags that catch the cases `strict` leaves open:"},"3211":{"id":"/strong-types-44","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"Flag"},"3212":{"id":"/strong-types-45","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"What it catches"},"3213":{"id":"/strong-types-46","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"`noUncheckedIndexedAccess`"},"3214":{"id":"/strong-types-47","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"Reading `arr[0]` or `map[k]` without handling a miss"},"3215":{"id":"/strong-types-48","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"`exactOptionalPropertyTypes`"},"3216":{"id":"/strong-types-49","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"Writing `{ description: undefined }` where the prop is simply absent"},"3217":{"id":"/strong-types-50","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"`noImplicitOverride`"},"3218":{"id":"/strong-types-51","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"A subclass method that silently stopped matching its base"},"3219":{"id":"/strong-types-52","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"`noImplicitReturns`, `noFallthroughCasesInSwitch`"},"3220":{"id":"/strong-types-53","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"A path that returns nothing; a `case` that runs into the next"},"3221":{"id":"/strong-types-54","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"`noUnusedLocals`, `noUnusedParameters`"},"3222":{"id":"/strong-types-55","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"Dead bindings (prefix an intentional unused parameter with `_`)"},"3223":{"id":"/strong-types-56","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"`useUnknownInCatchVariables`"},"3224":{"id":"/strong-types-57","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"Treating an unknown thrown value as an `Error`"},"3225":{"id":"/strong-types-58","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"`strictBuiltinIteratorReturn`, `alwaysStrict`, `forceConsistentCasingInFileNames`"},"3226":{"id":"/strong-types-59","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"Iterator variance, sloppy-mode drift, case-only path mismatches"},"3227":{"id":"/strong-types-60","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#typescript","content":"`noPropertyAccessFromIndexSignature` is deliberately `false` in `dashboard/tsconfig.json`: measured on this tree it flagged 232 sites where the code is correct, which would have trained everyone to ignore the gate. Two flags are also left off in `dashboard/eslint.config.mjs`, each with its reason written in the file header."},"3228":{"id":"/strong-types-61","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#closed-sets-live-in-one-place","content":"`dashboard/lib/types/index.ts` declares each closed set once as an `as const` array, and everything else derives from it:"},"3229":{"id":"/strong-types-62","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#closed-sets-live-in-one-place","content":"The type, the runtime allowlist, and the parser cannot drift apart, which is how `InferenceModelName` and `NemotronStackId` used to work: each was a hand-listed union mirroring a hand-listed `z.enum([...])` in `lib/validation.ts`."},"3230":{"id":"/strong-types-63","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#validate-at-the-boundary-not-at-the-call-site","content":"`dashboard/lib/services/cli-json.ts` is where utility stdout becomes a domain object. A parse failure throws `CliPayloadError` naming the utility and the field. The services that read the Resource Guard verdict go through it, so a broken payload reaches the existing error paths (`verdict: \"error\"`, an empty suggestion list) instead of reaching a renderer."},"3231":{"id":"/strong-types-64","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#validate-at-the-boundary-not-at-the-call-site","content":"Schemas are written so the inferred type *is* the domain type: no `as` casts, no `.passthrough()`. If a schema needs a cast to satisfy the compiler, the schema is wrong."},"3232":{"id":"/strong-types-65","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#validate-at-the-boundary-not-at-the-call-site","content":"Broad types are banned outright by the type-aware ESLint rules `no-explicit-any` and the `no-unsafe-*` family. Those rules need the TypeScript program, which is what `languageOptions.parserOptions.projectService` provides; without it they silently cannot run."},"3233":{"id":"/strong-types-66","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#indexing-is-an-assertion-not-a-guess","content":"`noUncheckedIndexedAccess` makes `rows[0]` and `map[\"k\"]` possibly `undefined`. A test that writes `rows[0].name` now fails to compile, and the tempting fix (`rows[0]!`) keeps the vacuous pass: an empty array would sail through and fail three property reads later with a message nobody can act on. Tests use the total accessors in `dashboard/lib/__tests__/test-assert.ts` instead:"},"3234":{"id":"/strong-types-67","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#indexing-is-an-assertion-not-a-guess","content":"Production code reaches for the same idea directly (`if (!x) return early`), since a dashboard has no business throwing on a missing row."},"3235":{"id":"/strong-types-68","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#python","content":"`mypy.ini` runs `strict` plus `disallow_any_explicit`, `disallow_any_generics`, and `disallow_subclassing_any`. `disallow_any_explicit` is the one that matters: it is not in `strict`, and it is what makes \"no `Any`\" a build failure rather than a review convention. `warn_unreachable`, `strict_equality`, and `extra_checks` treat dead code and impossible comparisons as defects, and `enable_error_code = ignore-without-code, redundant-cast, unused-ignore` means a suppression must name what it suppresses and cannot go stale."},"3236":{"id":"/strong-types-69","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#python","content":"There are no per-module `disallow_any_explicit = False` exemptions. Adding one needs a written reason in `mypy.ini`."},"3237":{"id":"/strong-types-70","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shared-vocabulary","content":"`scripts/lib/py/lab_types.py` holds the capacity vocabulary the Resource Guard and the dashboard agree on: `CapacityVerdict` (a `StrEnum`), and `TypedDict`s for `ResourceAmount`, `ModelSpec`, `StackSpec`, `ResourcePolicy`, `CapacityCheck`, and friends. A module that needs a shape not in there declares it file-local, and a reviewer decides whether it belongs in the shared module."},"3238":{"id":"/strong-types-71","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shared-vocabulary","content":"Prefer, in this order:"},"3239":{"id":"/strong-types-72","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shared-vocabulary","content":"a `TypedDict` when the code reads a known set of keys;"},"3240":{"id":"/strong-types-73","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shared-vocabulary","content":"`dict[str, object]` when a value is genuinely opaque and only re-serialised, with a comment saying so;"},"3241":{"id":"/strong-types-74","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shared-vocabulary","content":"a recursive `TypeAlias` (`JsonValue` in `tests/config_twin_check.py`) when walking arbitrary JSON."},"3242":{"id":"/strong-types-75","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shared-vocabulary","content":"Bare `dict`, `list`, `tuple`, and `set` are generics with the parameter left off, and mypy rejects them under `disallow_any_generics`."},"3243":{"id":"/strong-types-76","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#two-small-rules-that-matter","content":"At an untyped boundary (`json.loads`, `yaml.safe_load`, a stubless SDK), prefer `typing.cast` to a named `TypedDict` over an `isinstance` filter when the filter would substitute an empty value on malformed input. A cast is a runtime no-op, so it cannot change behaviour; a filter can. Where both are honest, validate."},"3244":{"id":"/strong-types-77","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#two-small-rules-that-matter","content":"To assert a value is present and narrow it, return `NoReturn` from the failure helper rather than using `assert`:"},"3245":{"id":"/strong-types-78","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shell","content":"Bash has no type system, so `scripts/lib/types.sh` supplies the equivalent: predicate functions that answer a value-kind question, and `require_*` functions that validate a parameter and abort with a diagnostic."},"3246":{"id":"/strong-types-79","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shell","content":"The contract every function in that file keeps:"},"3247":{"id":"/strong-types-80","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shell","content":"a predicate returns `0` or `1` and never calls `exit`;"},"3248":{"id":"/strong-types-81","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shell","content":"a failure writes exactly one diagnostic to **stderr** naming the parameter, so a utility's stdout stays clean for `$(...)` capture;"},"3249":{"id":"/strong-types-82","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shell","content":"the library carries no `set -euo pipefail`, because it inherits the caller's options;"},"3250":{"id":"/strong-types-83","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shell","content":"every function has a `# @function` tag and `# @param` lines."},"3251":{"id":"/strong-types-84","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shell","content":"Predicates come in signed and unsigned pairs (`is_integer` / `is_unsigned_integer`, `is_number` / `is_unsigned_number`) because counters and telemetry readbacks are non-negative, and accepting a leading `-` there turns a parse glitch into a negative number rather than a rejection."},"3252":{"id":"/strong-types-85","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#shell","content":"A utility that installs itself outside the repo, such as `spark-clock.sh`, which the systemd unit execs from `/usr/local/bin` where there is no `../lib` sibling, stays self-contained on purpose. `//tests:bats_tooling_test` holds that boundary with a guard test. Repo-bound utilities source the library unconditionally, so a missing file fails loudly at source time rather than running with the predicates undefined."},"3253":{"id":"/strong-types-86","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#data-files","content":"Several configs ship as a `.yaml` plus a `.json` twin, and the readers load the JSON. That makes a half-finished edit silent rather than loud. `tests/config_twin_check.py` parses both sides and reports the first path where they disagree:"},"3254":{"id":"/strong-types-87","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#data-files","content":"It runs inside `//tests:safety_invariants`, so drift fails the fast CI lane."},"3255":{"id":"/strong-types-88","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#when-a-broad-type-really-is-right","content":"Some values have no shape worth declaring: a Kubernetes `status` blob that the code only re-serialises, an arbitrary key path from a policy file, a Prometheus sample that mixes a float and a string. Use `object` (or `unknown` in TypeScript), and write the reason in a comment on that line. What is not acceptable is the broad type as a default, chosen because declaring the shape was more work than the change was worth."},"3256":{"id":"/strong-types-89","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#adding-a-type-adding-a-gate","content":"**A new data shape.** Put it where its consumers can both see it: `dashboard/lib/types/index.ts` when TypeScript on both sides of a boundary needs it, `scripts/lib/py/lab_types.py` when Python does. If a set is closed, declare it once as an `as const` array (TypeScript) or a `StrEnum` (Python) and derive the rest."},"3257":{"id":"/strong-types-90","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#adding-a-type-adding-a-gate","content":"**A new gate.** When a convention is easy to violate, encode it as a check rather than relying on reminder. One rule governs new gates, and it is the lesson of this repository's history: a gate that inspected nothing must not pass. `//lints:mypy` used to print `mypy: no tracked Python files` and `exit 0` because `git ls-files` fails in the Bazel runfiles sandbox, so the Python type gate had never once run; `//lints:yaml_format` resolved its repo root one directory too shallow, globbed zero files, and exited `0`. Both now treat an empty file list as a hard failure. If you add a check that can find nothing to check, make finding nothing an error."},"3258":{"id":"/strong-types-91","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#see-also","content":"Project Conventions — the shared rules this page extends"},"3259":{"id":"/strong-types-92","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#see-also","content":"Contributing to Docs — how a page gets into the nav"},"3260":{"id":"/strong-types-93","page_id":"/strong-types","tags":["conventions","typescript","python","shell","safety","contributing"],"type":"text","url":"/strong-types#see-also","content":"Shell Commands & Helpers — the generated shell index"},"3261":{"id":"/troubleshooting","page_id":"/troubleshooting","type":"page","content":"Troubleshooting","breadcrumbs":["Docs"],"tags":["troubleshooting","safety","bazel","kubernetes","nvidia"],"url":"/troubleshooting"},"3262":{"id":"/troubleshooting-0","page_id":"/troubleshooting","tags":["troubleshooting","safety","bazel","kubernetes","nvidia"],"type":"text","url":"/troubleshooting","content":"Decision tree and symptom → cause → action → prevention → verify tables for SSH, scheduler, NCCL, Grafana, dashboard, and mode collisions."},"3263":{"id":"/troubleshooting-1","page_id":"/troubleshooting","type":"heading","tags":["troubleshooting","safety","bazel","kubernetes","nvidia"],"url":"/troubleshooting#troubleshooting","content":"Troubleshooting"},"3264":{"id":"/troubleshooting-2","page_id":"/troubleshooting","type":"heading","tags":["troubleshooting","safety","bazel","kubernetes","nvidia"],"url":"/troubleshooting#decision-tree","content":"Decision tree"},"3265":{"id":"/troubleshooting-3","page_id":"/troubleshooting","type":"heading","tags":["troubleshooting","safety","bazel","kubernetes","nvidia"],"url":"/troubleshooting#ssh-unresponsive","content":"SSH unresponsive"},"3266":{"id":"/troubleshooting-4","page_id":"/troubleshooting","type":"heading","tags":["troubleshooting","safety","bazel","kubernetes","nvidia"],"url":"/troubleshooting#scheduler--no-resources","content":"Scheduler / no resources"},"3267":{"id":"/troubleshooting-5","page_id":"/troubleshooting","type":"heading","tags":["troubleshooting","safety","bazel","kubernetes","nvidia"],"url":"/troubleshootin