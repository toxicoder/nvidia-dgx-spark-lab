s","safety"],"type":"text","url":"/operate/overlays#theory","content":"Rounded overlay (Mode A) is mutually exclusive with GLM-5.3-Flash and DeepSeek-V4.1-Flash starts. The CLI refuses collisions."},"3813":{"id":"/operate/patch-and-reboot","page_id":"/operate/patch-and-reboot","type":"page","content":"Patch and reboot","breadcrumbs":["Docs","Operate"],"tags":["reboot","safety","operate","kubernetes"],"url":"/operate/patch-and-reboot"},"3814":{"id":"/operate/patch-and-reboot-0","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot","content":"OS patch, GPU Operator, drain, stop inference first, and reboot order for DGX Spark nodes."},"3815":{"id":"/operate/patch-and-reboot-1","page_id":"/operate/patch-and-reboot","type":"heading","tags":["reboot","safety","operate","kubernetes"],"url":"/operate/patch-and-reboot#patch-and-reboot","content":"Patch and reboot"},"3816":{"id":"/operate/patch-and-reboot-2","page_id":"/operate/patch-and-reboot","type":"heading","tags":["reboot","safety","operate","kubernetes"],"url":"/operate/patch-and-reboot#sequence","content":"Sequence"},"3817":{"id":"/operate/patch-and-reboot-3","page_id":"/operate/patch-and-reboot","type":"heading","tags":["reboot","safety","operate","kubernetes"],"url":"/operate/patch-and-reboot#after-reboot","content":"After reboot"},"3818":{"id":"/operate/patch-and-reboot-4","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"**What's on this page**"},"3819":{"id":"/operate/patch-and-reboot-5","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"type":"text","url":"/operate/patch-and-reboot#patch-and-reboot","content":"Stop inference before any host reboot"},"3820":{"id":"/operate/patch-and-reboot-6","page_id":"/operate/patch-and-reboot","tags":["reboot","safety","operate","kubernetes"],"typ