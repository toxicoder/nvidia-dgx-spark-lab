{
  "name": "dgx-lab-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:latest": "NEXT_BASE_PATH=/latest next build",
    "build:development": "NEXT_BASE_PATH=/development DGX_DOCS_VERSION=development next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "python3 -m unittest discover -s . -p 'test_*.py' -t .",
    "nav:generate": "python3 scripts/gen_nav.py",
    "nav:check": "python3 scripts/gen_nav.py --check",
    "codemod": "python3 scripts/codemod_mkdocs_to_mdx.py",
    "codemod:check": "python3 scripts/codemod_mkdocs_to_mdx.py --check",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "visual:linux": "bash scripts/visual_linux.sh",
    "visual:linux:update": "bash scripts/visual_linux.sh --update",
    "unit": "vitest run",
    "verify": "node scripts/verify_site.mjs",
    "serve": "node scripts/serve_static.mjs"
  },
  "dependencies": {
    "cn": "^0.3.0",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.15.11",
    "fumadocs-mdx": "^15.4.1",
    "fumadocs-ui": "^16.15.11",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
