{
  // ── Editor defaults (match prettier.config.mjs + ruff.toml) ──
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [100, 120],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  // ── Hide build artifacts, caches, generated docs & golden images ──
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.venv*": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/bazel-bin": true,
    "**/bazel-out": true,
    "**/bazel-testlogs": true,
    "**/bazel-lab": true,
    "**/coverage": true,
    "**/test-results": true,
    "site": true,
    "docs/generated": true,
    "dashboard/tests/visual/goldens": true,
    "**/package-lock.json": true,
    "**/MODULE.bazel.lock": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/bazel-bin": true,
    "**/bazel-out": true,
    "**/bazel-testlogs": true,
    "**/bazel-lab": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.venv*": true,
    "**/coverage": true,
    "**/test-results": true,
    "site": true,
    "docs/generated": true,
    "dashboard/tests/visual/goldens": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/bazel-*/**": true,
    "**/__pycache__/**": true,
    "**/.venv*/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "site/**": true,
    "docs/generated/**": true,
    "dashboard/tests/visual/goldens/**": true
  },

  // ── File associations ──
  "files.associations": {
    "BUILD": "starlark",
    "BUILD.bazel": "starlark",
    "*.bzl": "starlark",
    "*.bazel": "starlark",
    "*.bats": "shellscript",
    "globals.css": "tailwindcss"
  },

  // ── Per-language formatters (aligned with //:fix and pre-commit) ──
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[shellscript]": { "editor.defaultFormatter": "mkhl.shfmt", "editor.formatOnSave": true },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on"
  },
  "[starlark]": { "editor.formatOnSave": true },

  // ── Python: Ruff + Mypy as the single type checker ──
  // ⚠ Perf-critical on a large monorepo: openFiles + indexing off avoids full-repo crawl.
  // Interpreter is pinned in .devcontainer/devcontainer.json (do not set defaultInterpreterPath).
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.indexing": false,
  "python.analysis.exclude": [
    "**/__pycache__",
    "**/.*",
    "**/node_modules",
    "**/site",
    "**/.venv*",
    "**/bazel-*",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/coverage",
    "**/test-results",
    "docs/generated",
    "dashboard/tests/visual/goldens"
  ],
  "python.analysis.diagnosticSeverityOverrides": { "reportMissingImports": "none" },

  "ruff.configuration": "${workspaceFolder}/ruff.toml",
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.importStrategy": "fromEnvironment",
  "ruff.nativeServer": "on",
  "ruff.lineLength": 100,
  "ruff.organizeImports": true,
  "ruff.lint.enable": true,
  "ruff.enable": true,

  "mypy-type-checker.args": ["--config-file", "${workspaceFolder}/mypy.ini"],
  "mypy-type-checker.cwd": "${workspaceFolder}",
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.preferDaemon": true,
  "mypy-type-checker.reportingScope": "filesOnly",
  "mypy-type-checker.ignorePatterns": [
    "**/site/**",
    "**/.venv*/**",
    "**/node_modules/**",
    "**/bazel-*/**",
    "**/__pycache__/**",
    "docs/generated/**",
    "dashboard/tests/visual/goldens/**"
  ],
  "mypy-type-checker.severity": { "error": "Error", "note": "Information" },

  // ── Shell ──
  "shfmt.executable": "shfmt",
  "shfmt.args": ["-i", "2", "-s", "-ci"],
  "shellcheck.enable": true,
  "shellcheck.run": "onSave",
  "shellcheck.customArgs": ["-x", "--severity=warning"],

  // ── Bazel / Starlark ──
  "bazel.executable": "bazelisk",
  "bazel.buildifierFixOnFormat": true,
  "bazel.enableCodeLens": true,

  // ── Prettier (root config for YAML + dashboard) ──
  "prettier.configPath": "prettier.config.mjs",
  "prettier.ignorePath": ".prettierignore",
  "prettier.requireConfig": true,

  // ── Dashboard TS / ESLint ──
  "js/ts.tsdk.path": "dashboard/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "directory": "dashboard", "changeProcessCWD": true }],
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // ── Tailwind CSS v4 ──
  "tailwindCSS.experimental.configFile": "dashboard/app/globals.css",
  "tailwindCSS.includeLanguages": { "typescript": "javascript", "typescriptreact": "javascript" },

  // ── YAML / K8s / Ansible ──
  "yaml.validate": true,
  "yaml.schemaStore.enable": true,
  "yaml.format.enable": false,
  "yaml.customTags": ["!reference sequence"],
  "redhat.telemetry.enabled": false,
  "ansible.validation.enabled": true,
  "ansible.lint.enabled": true,

  // ── Vitest ──
  "vitest.enable": true,
  "vitest.rootConfig": "dashboard/vitest.config.ts",

  // ── Terminal & Git ──
  "terminal.integrated.defaultProfile.osx": "zsh",
  "git.ignoreLimitWarning": true,
  "git.pull.rebase": true,
  "git.rebaseWhenSync": true,
  "githubPullRequests.defaultMergeMethod": "rebase"
}
