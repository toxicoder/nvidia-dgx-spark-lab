# nvidia-dgx-spark-lab Ansible Inventory (legacy hand-made example)
# Copy to hosts.ini and fill in your actual addresses.
#
# Prefer ansible/inventory/lab.yaml + `manage.sh setup` / `topology render`.
# That path generates this file (gitignored) plus per-node netplan and
# cloud-init. Use this example only for manual labs.
#
# ansible_user is the day-2 principal (lab-ansible). First-contact from a
# factory image still uses bootstrap_user (ubuntu) via:
#   bazelisk run //:manage -- identities apply --yes
#
# Supported sizes: 1-5 DGX Spark nodes.
# - 1 node (`fabric: none`): one all-in-one control-plane + worker. Local NCCL.
# - 2 nodes (`pair`): one 200 Gb/s QSFP cable.
# - 3 nodes (`ring`): QSFP triangle, 200 Gb/s per pair.
# - 4-5 nodes (`switch`): CRS804; Spark links are 200 Gb/s (5-node uses a
#   breakout of one 400G QSFP-DD port into two 200G lanes).
# Any node can be the K3s server (`role: orchestrator` in lab.yaml).
#
# Node lines beyond spark0 are commented out. Uncomment for a larger lab.

# Example for 1 node: uncomment only the spark0 lines.
# Example for 2-5 nodes: uncomment the spark1+ lines in [k3s_cluster] and
# [k3s_agent] (host lines carry the vars; no per-node groups needed).

[k3s_cluster]
spark0 ansible_host=10.0.0.10 ansible_user=lab-ansible
# spark1 ansible_host=10.0.0.11 ansible_user=lab-ansible
# spark2 ansible_host=10.0.0.12 ansible_user=lab-ansible
# spark3 ansible_host=10.0.0.13 ansible_user=lab-ansible
# spark4 ansible_host=10.0.0.14 ansible_user=lab-ansible

[k3s_server]
spark0

[k3s_agent]
# spark1
# spark2
# spark3
# spark4

# Optional: make inventory/group_vars/generated/fabric.yml apply (generated
# inventory from lab.yaml already includes this group).
[generated:children]
k3s_cluster

# High-speed interconnect configuration (for 2+ nodes).
# Pair reference names only — confirm with ibdev2netdev. Ignored on 1 node.
# Do not copy this pair list onto a ring or switch lab.
[highspeed]
spark0 enp1s0f0np0=enp1s0f0np0 enp1s0f1np1=enp1s0f1np1
# spark1 enp1s0f0np0=enp1s0f0np0 enp1s0f1np1=enp1s0f1np1
# spark2 enp1s0f0np0=enp1s0f0np0 enp1s0f1np1=enp1s0f1np1
# spark3 enp1s0f0np0=enp1s0f0np0 enp1s0f1np1=enp1s0f1np1
# spark4 enp1s0f0np0=enp1s0f0np0 enp1s0f1np1=enp1s0f1np1
