    visibility = ["//visibility:public"],
)

alias(
    name = "docs-build",
    actual = "//docs:docs",
    visibility = ["//visibility:public"],
)

alias(
    name = "docs",
    actual = "//docs:docs",
    visibility = ["//visibility:public"],
)

alias(
    name = "docs-status",
    actual = "//docs:status",
    visibility = ["//visibility:public"],
)

alias(
    name = "docs-clean",
    actual = "//docs:clean",
    visibility = ["//visibility:public"],
)

alias(
    name = "docs-preview",
    actual = "//docs:preview",
    visibility = ["//visibility:public"],
