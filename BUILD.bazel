"""Package purpose: Root Bazel targets for test suites, lint aggregation, docs/dashboard/ansible aliases, and repo-wide entry points.

Bazel is the primary entry point: build, test, lint, docs, and operational scripts.

Common entry points:

  bazelisk run //:validate              # git-aware build + test + lint + docs/dashboard
  bazelisk test //:test                 # full hermetic suite (incl. docs gates)
  bazelisk test //:test-fast            # CI core (excludes slow docs Playwright)
  bazelisk test //:lint --test_tag_filters=manual   # all lints (requires host tools)
  bazelisk run //:manage -- status      # cluster management (wraps scripts/manage.sh)
  bazelisk run //docs:serve             # local docs dev server (Fumadocs / Next.js)
  bazelisk run //dashboard:hermetic-test  # Docker-isolated Vitest + build + Playwright

See docs/BUILDING_WITH_BAZEL.md for the full guide.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:private"])

exports_files([
    ".ansible-lint",
    ".prettierignore",
    ".yamllint.yml",
    "CONTRIBUTING.md",
    "README.md",
    "fix.sh",
    "mypy.ini",
    "prettier.config.mjs",
])

# Devcontainer sources for hermetic contributor-env tests (multi-arch amd64/arm64).
filegroup(
    name = "devcontainer",
    srcs = [
        ".devcontainer/.dockerignore",
        ".devcontainer/Dockerfile",
        ".devcontainer/README.md",
        ".devcontainer/devcontainer.json",
        ".devcontainer/devcontainer-lock.json",
        ".devcontainer/docker-bake.hcl",
        ".devcontainer/doctor.sh",
        ".devcontainer/grok-managed.toml",
        ".devcontainer/host-llm.example.toml",
        ".devcontainer/install-agent-clis.sh",
        ".devcontainer/post-create.sh",
        ".devcontainer/sandbox.toml",
        ".devcontainer/tool-versions.env",
    ],
    visibility = ["//visibility:public"],
)

# CI workflow / composite action YAML (hermetic pin checks; no secrets).
filegroup(
    name = "ci_workflows",
    srcs = [
        ".gitea/workflows/ci.yml",
        ".github/actions/setup-bazel/action.yml",
        ".github/dependabot.yml",
        ".github/workflows/ci.yml",
        ".github/workflows/deploy-docs.yml",
        ".github/workflows/devcontainer-image.yml",
        ".github/workflows/publish-images.yml",
        ".github/container-images.json",
        ".dockerignore",
    ],
    visibility = ["//visibility:public"],
)

# Re-export the primary operational binary.
alias(
    name = "manage",
    actual = "//scripts:manage",
    visibility = ["//visibility:public"],
)

# The full hermetic BATS safety test suite.
alias(
    name = "bats",
    actual = "//tests:bats",
    visibility = ["//visibility:public"],
)

# The simple smoke test for the script.
alias(
    name = "manage_help_test",
    actual = "//scripts:manage_help_test",
    visibility = ["//visibility:public"],
)

# Fast hermetic core for CI (bazel-core). Browser-free by design: the Playwright visual
# suite and the Next.js production build need a browser and a full npm install, so they run
# in the docs-and-render job via //docs-site:visual instead of here.
_TEST_FAST = [
    "//docs-site:codemod_test",
    "//docs-site:nav_test",
    "//docs-site:typecheck",
    "//docs-site:unit",
    "//docs:test_command_vars",
    "//docs:test_docs_site_render",
    "//docs:test_generate_shell_docs",
    "//docs:test_python_coverage",
    "//scripts:manage_help_test",
    "//tests:bats",
    "//tests:kustomize_build",
    "//tests:manifest_coverage",
    "//tests:doc_coverage",
    "//tests:doc_coverage_unit",
    "//tests:safety_invariants",
]

test_suite(
    name = "test-fast",
    tests = _TEST_FAST,
    visibility = ["//visibility:public"],
)

# Full local/validation suite.  //docs-site:visual-test is tagged manual (Chromium cannot
# launch inside the sandboxed test action); run it with //docs-site:visual or let the CI
# docs job drive it after installing the browser.
test_suite(
    name = "test",
    tests = _TEST_FAST,
    visibility = ["//visibility:public"],
)

# Convenience: build everything (key artifacts).
filegroup(
    name = "all",
    srcs = [
        ":manage",
        "//docs",
        "//docs-site:sources",
    ],
    visibility = ["//visibility:public"],
)

# Aggregate lint targets (Bazel + subpackages)
test_suite(
    name = "lint",
    tags = ["lint"],
    tests = [
        "//ansible:validate",
        "//lints:all",
    ],
    visibility = ["//visibility:public"],
)

