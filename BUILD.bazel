"""Package purpose: Root Bazel targets for test suites, lint aggregation, docs/dashboard/ansible aliases, and repo-wide entry points.

Bazel is the only entry point: build, test, lint, docs, and operational scripts.
No script in this repository is meant to be invoked directly.

Common entry points:

  bazelisk run //:validate              # git-aware build + test + lint + docs/dashboard
  bazelisk test  //:verify              # the pre-push gate (same suite as //:test)
  bazelisk build //:everything          # build every Bazel-owned artifact
  bazelisk test //:test                 # CI core + the heavier browser-free gates
  bazelisk test //:test-fast            # CI core (excludes slow docs Playwright)
  bazelisk test //:lint --test_tag_filters=manual   # all lints (requires host tools)
  bazelisk run //:manage -- status      # cluster management (the only ops entry point)
  bazelisk run //:doctor                # contributor toolchain check
  bazelisk run //docs:serve             # local docs dev server (Fumadocs / Next.js)
  bazelisk run //dashboard:hermetic-test  # Docker-isolated Vitest + build + Playwright

//tests:bazel_file_coverage keeps this honest: every tracked file is named by a
Bazel rule, and each wildcard glob() pattern is sanctioned in writing.

See docs/BUILDING_WITH_BAZEL.md for the full guide.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:private"])

exports_files([
    ".ansible-lint",
    ".bazelignore",
    ".prettierignore",
    ".yamllint.yml",
    "CONTRIBUTING.md",
    "README.md",
    "fix.sh",
    "mypy.ini",
    "prettier.config.mjs",
])

# Devcontainer sources for hermetic contributor-env tests (multi-arch amd64/arm64).
filegroup(
    name = "devcontainer",
    srcs = [
        ".devcontainer/.dockerignore",
        ".devcontainer/Dockerfile",
        ".devcontainer/README.md",
        ".devcontainer/devcontainer.json",
        ".devcontainer/devcontainer-lock.json",
        ".devcontainer/docker-bake.hcl",
        ".devcontainer/doctor.sh",
        ".devcontainer/grok-managed.toml",
        ".devcontainer/host-llm.example.toml",
        ".devcontainer/install-agent-clis.sh",
        ".devcontainer/post-create.sh",
        ".devcontainer/run_doctor.sh",
        ".devcontainer/sandbox.toml",
        ".devcontainer/tool-versions.env",
    ],
    visibility = ["//visibility:public"],
)

# CI workflow / composite action YAML (hermetic pin checks; no secrets).
filegroup(
    name = "ci_workflows",
    srcs = [
        ".dockerignore",
        ".gitea/workflows/ci.yml",
        ".github/actions/setup-bazel/action.yml",
        ".github/container-images.json",
        ".github/dependabot.yml",
        ".github/scripts/install-lint-tools.sh",
        ".github/workflows/ci.yml",
        ".github/workflows/dashboard-goldens.yml",
        ".github/workflows/deploy-docs.yml",
        ".github/workflows/devcontainer-image.yml",
        ".github/workflows/publish-images.yml",
    ],
    visibility = ["//visibility:public"],
)

# Re-export the primary operational binary.
alias(
    name = "manage",
    actual = "//scripts:manage",
    visibility = ["//visibility:public"],
)

# The full hermetic BATS safety test suite.
alias(
    name = "bats",
    actual = "//tests:bats",
    visibility = ["//visibility:public"],
)

# The simple smoke test for the script.
alias(
    name = "manage_help_test",
    actual = "//scripts:manage_help_test",
    visibility = ["//visibility:public"],
)

# Contributor-environment doctor (required CLI tools, pinned versions, venvs).
# `bazelisk run //:doctor -- --quiet` passes flags through to the script.
sh_binary(
    name = "doctor",
    srcs = [".devcontainer/run_doctor.sh"],
    data = [
        ".devcontainer/doctor.sh",
        ".devcontainer/tool-versions.env",
    ],
    visibility = ["//visibility:public"],
)

# Fast hermetic core for CI (bazel-core). Browser-free by design: the Playwright visual
# suite and the Next.js production build need a browser and a full npm install, so they run
# in the docs-and-render job via //docs-site:visual instead of here.
_TEST_FAST = [
    "//docs-site:codemod_test",
    "//docs-site:nav_test",
    "//docs-site:typecheck",
    "//docs-site:unit",
    "//docs:test_command_vars",
    "//docs:test_docs_site_render",
    "//docs:test_generate_shell_docs",
    "//docs:test_python_coverage",
    "//scripts:manage_help_test",
    "//tests:bats",
    "//tests:kustomize_build",
    "//tests:manifest_coverage",
    "//tests:doc_coverage",
    "//tests:doc_coverage_unit",
    "//tests:safety_invariants",
    "//tests:bazel_file_coverage",
    "//tests:bazel_file_coverage_unit",
]

test_suite(
    name = "test-fast",
    tests = _TEST_FAST,
    visibility = ["//visibility:public"],
)

# Full local/validation suite: the CI core plus the heavier browser-free gates a
# contributor should run before pushing. //docs:render-check is an sh_binary rather
# than a test (it is driven by `bazelisk run //docs:render-check`, which //:validate
# does after //docs:docs), and the browser suites are tagged manual (//docs-site:visual,
# //dashboard:hermetic-test).
_TEST = _TEST_FAST + [
    "//docs-site:visual_tooling_test",
]

test_suite(
    name = "test",
    tests = _TEST,
    visibility = ["//visibility:public"],
)

# Convenience: build everything (key artifacts).
filegroup(
    name = "all",
    srcs = [
        ":manage",
        "//docs",
        "//docs-site:sources",
    ],
    visibility = ["//visibility:public"],
)

# Every Bazel-owned artifact in the repository. `bazelisk build //:everything`
# is the single build-everything entry point; //tests:bazel_file_coverage proves
# that each tracked file is named by one of these package aggregates.
filegroup(
    name = "everything",
    srcs = [
        ":ci_workflows",
        ":devcontainer",
        ":editor_config",
        ":repo_config",
        ":repo_docs",
        "//ansible:all",
        "//config:all",
        "//dashboard:sources",
        "//docs",
        "//docs-site:sources",
        "//helm:all",
        "//hermes:all",
        "//k8s:all",
        "//mcp:all",
        "//scripts:all",
        "//tests:all",
    ],
    visibility = ["//visibility:public"],
)

# Single run-everything entry point: `bazelisk test //:verify`.
#
# Fast, hermetic gates that must stay green on every change, plus the heavier
# browser-free gates. The host-tool lints (//lints:all) and the browser suites
# (//docs-site:visual, //dashboard:hermetic-test) are tagged manual and are driven
# by `bazelisk run //:validate`, which mirrors CI. Same set as //:test; this is the
# name to type when you want one command that says "is my work good to push".
test_suite(
    name = "verify",
    tests = _TEST,
    visibility = ["//visibility:public"],
)

# Repository tooling configuration (repo hygiene hooks, editor/IDE settings).
# Owned here so no tracked file sits outside the Bazel graph.
filegroup(
    name = "repo_config",
    srcs = [
        ".gitattributes",
        ".gitignore",
        ".pre-commit-config.yaml",
        "mypy.ini",
        "prettier.config.mjs",
        "ruff.toml",
    ],
    visibility = ["//visibility:public"],
)

# Repository-level prose and the Makefile compatibility shim.
filegroup(
    name = "repo_docs",
    srcs = [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "MIGRATION.md",
        "Makefile",
        "README.md",
        "SECURITY.md",
    ],
    visibility = ["//visibility:public"],
)

# VS Code tasks, launch configs, and recommendations (see docs/dev-environment.mdx).
filegroup(
    name = "editor_config",
    srcs = [
        ".vscode/extensions.json",
        ".vscode/launch.json",
        ".vscode/settings.json",
        ".vscode/tasks.json",
    ],
    visibility = ["//visibility:public"],
)

# Aggregate lint targets (Bazel + subpackages)
test_suite(
    name = "lint",
    tags = ["lint"],
    tests = [
        "//ansible:validate",
        "//lints:all",
    ],
    visibility = ["//visibility:public"],
)

